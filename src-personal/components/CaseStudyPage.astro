---
import Layout from '../../src/layouts/Layout.astro';
import { caseStudies, caseStudiesEn, caseVisuals, pairSlug, type CaseStudy } from '../caseStudies';

interface Props { study: CaseStudy; locale: 'de' | 'en' }
const { study, locale } = Astro.props;
const de = locale === 'de';
const base = de ? '/beispiele/' : '/en/case-studies/';
const otherBase = de ? '/en/case-studies/' : '/beispiele/';
const url = `https://treppmann.de${base}${study.slug}/`;
const pairUrl = `https://treppmann.de${otherBase}${pairSlug(study.slug)}/`;
const home = de ? '/' : '/en/';
const bookUrl = 'https://fantastical.app/tobiastreppmann';
const v = caseVisuals[study.slug];
const others = (de ? caseStudies : caseStudiesEn).filter((s) => s.slug !== study.slug);
const t = de ? {
  skip: 'Zum Inhalt', homeLabel: 'Tobias Treppmann – Startseite', suffix: 'KI-Transformation', contact: 'Kontakt',
  back: 'Alle Beispiele', kicker: 'Beispiel', facts: 'Auf einen Blick',
  ctaTitle: 'Haben Sie einen ähnlichen Prozess?', ctaBody: 'In 30 Minuten sprechen wir darüber, wo KI bei Ihnen ansetzen könnte. Kostenlos und ohne Verpflichtung.', book: 'Erstgespräch vereinbaren', subject: 'Beispiel: ',
  more: 'Weitere Beispiele', read: 'Beispiel lesen', jump: 'Inhalt', secs: ['Ausgangslage', 'Vorgehen', 'Ergebnis', 'Für Ihr Unternehmen'], human: 'Mensch', ai: 'KI', impressum: 'Impressum', privacy: 'Datenschutz', homeLink: 'Startseite', lang: 'de-DE', switchLabel: 'EN',
} : {
  skip: 'Skip to content', homeLabel: 'Tobias Treppmann – home', suffix: 'AI Transformation', contact: 'Contact',
  back: 'All examples', kicker: 'Example', facts: 'At a glance',
  ctaTitle: 'Do you have a similar process?', ctaBody: 'In 30 minutes we talk about where AI could start for you. Free and without obligation.', book: 'Book an intro call', subject: 'Example: ',
  more: 'More examples', read: 'Read example', jump: 'Contents', secs: ['Starting point', 'Approach', 'Result', 'For your company'], human: 'Person', ai: 'AI', impressum: 'Legal notice', privacy: 'Privacy', homeLink: 'Home', lang: 'en', switchLabel: 'DE',
};
const structuredData = {
  '@context': 'https://schema.org',
  '@type': 'Article',
  headline: study.title,
  description: study.description,
  inLanguage: t.lang,
  author: { '@type': 'Person', name: 'Tobias Treppmann', url: `https://treppmann.de${home}` },
  mainEntityOfPage: url,
};
// Article layout (brand/VOICE-DE.md section 7) when the study has chapters; otherwise the classic layout.
const article = !!study.chapters;
const pad = (n: number) => String(n).padStart(2, '0');
const navItems: string[] = article
  ? [study.situation.nav ?? study.situation.title, ...(study.turn ? [study.turn.nav ?? study.turn.title] : []), ...study.chapters!.map((c) => c.nav ?? c.title), study.result.nav ?? study.result.title, ...(study.takeaways ? [study.takeaways.nav ?? study.takeaways.title] : [])]
  : t.secs;
const turnNum = 2;
const chapterStart = study.turn ? 3 : 2;
const resultNum = article ? chapterStart + study.chapters!.length : 3;
const ctaTitle = study.cta?.title ?? t.ctaTitle;
const ctaBody = study.cta?.body ?? t.ctaBody;
const deUrl = de ? url : pairUrl;
const enUrl = de ? pairUrl : url;
---


<Layout lang={t.lang} title={`${study.title} – Tobias Treppmann`} description={study.description} canonical={url} alternateDe={deUrl} alternateEn={enUrl} alternateDefault={deUrl} image="https://treppmann.de/images/tobias-treppmann.jpg" structuredData={structuredData}>
  <a class="skip-link" href="#main">{t.skip}</a>
  <header class="topbar leadership-topbar">
    <a class="brand" href={home} aria-label={t.homeLabel}>
      <span>Tobias Treppmann</span><span class="brand-mark">/</span><span>{t.suffix}</span>
    </a>
    <div class="topbar-actions">
      <a class="topbar-contact" href={`${home}#contact`}>{t.contact}</a>
      <a class="language" href={pairUrl.replace('https://treppmann.de', '')} lang={de ? 'en' : 'de'}>{t.switchLabel}</a>
    </div>
  </header>

  <main class="case-page" id="main">
    <section class="case-hero section-dark">
      <div class="section-shell case-hero-shell">
        <div>
          <p class="case-back"><a href={`${home}#proof`}><span aria-hidden="true">← </span>{t.back}</a></p>
          <p class="section-label">{t.kicker} · {study.label}</p>
          <h1>{study.title}</h1>
          <p class="case-lead">{study.lead}</p>
        </div>
        <figure class={`collage-object case-hero-object shape-${study.shape}`} aria-hidden="true">
          <img src={`/images/collage/${study.object}.webp`} alt="" />
        </figure>
      </div>
    </section>

    <section class="case-facts section-paper" aria-label={t.facts}>
      <dl class:list={['section-shell case-facts-list', { 'is-long': study.facts.length > 3 }]} data-reveal data-stagger>
        {study.facts.map(([k, v], i) => (
          <div style={`--i:${i}`}><dt>{k}</dt><dd>{v}</dd></div>
        ))}
      </dl>
    </section>

    <nav class="case-jump section-paper" aria-label={t.jump}>
      <ol class="section-shell">
        {navItems.map((label, i) => <li><a href={`#teil-${i + 1}`}><b>{String(i + 1).padStart(2, '0')}</b>{label}</a></li>)}
      </ol>
    </nav>

    {article ? (
    <section class="case-body section-paper">
      {study.opening && (
        <div class="section-shell case-opening" data-reveal>
          <h2>{study.opening.title}</h2>
          <div class="case-prose">{study.opening.paras.map((p) => <p>{p}</p>)}</div>
          {study.nut && <p class="case-nut">{study.nut}</p>}
        </div>
      )}

      <div class="section-shell case-grid" id="teil-1" data-reveal>
        <h2><span class="case-num">01</span>{study.situation.title}</h2>
        <div class="case-prose">{study.situation.paras.map((p) => <p>{p}</p>)}</div>
      </div>

      {study.turn && (
        <div class="section-shell case-grid case-turn" id={`teil-${turnNum}`} data-reveal>
          <h2><span class="case-num">{pad(turnNum)}</span>{study.turn.title}</h2>
          <div class="case-prose">{study.turn.paras.map((p) => <p>{p}</p>)}</div>
        </div>
      )}

      <blockquote class="section-shell case-quote" data-reveal>
        <p>{v.quote.text}</p>
        <cite>{v.quote.by}</cite>
      </blockquote>

      <figure class={`section-shell case-flow is-${v.flow.kind}`} data-reveal data-stagger>
        <figcaption>
          <span>{v.flow.title}</span>
          {v.flow.kind === 'flow' && <span class="case-flow-legend"><i class="is-human"></i>{t.human}<i class="is-ai"></i>{t.ai}</span>}
        </figcaption>
        <ol>
          {v.flow.nodes.map(([title, sub, who], i) => (
            <li class={`is-${who}`} style={`--i:${i}; --n:${v.flow.kind === 'timeline' ? Math.round((i + 1) * 5 / v.flow.nodes.length) : 5}`}>
              {v.flow.kind === 'flow' && who !== 'neutral' && <em>{who === 'ai' ? t.ai : t.human}</em>}
              <strong>{title}</strong><span>{sub}</span>
            </li>
          ))}
        </ol>
      </figure>

      {study.chapters!.map((c, i) => (
        <div class="section-shell case-grid case-chapter" id={`teil-${chapterStart + i}`} data-reveal>
          <h2><span class="case-num">{pad(chapterStart + i)}</span>{c.title}</h2>
          <div class="case-prose">{c.paras.map((p) => <p>{p}</p>)}</div>
        </div>
      ))}

      {study.images && (
        <div class="section-shell case-images" data-reveal>
          {study.images.map((img, i) => (
            <figure style={`--tilt:${i % 2 ? 1 : -1}deg`}>
              <img src={img.src} alt={img.alt} width={img.width} height={img.height} loading="lazy" />
              <figcaption>{img.caption}</figcaption>
            </figure>
          ))}
        </div>
      )}
    </section>
    ) : (
    <section class="case-body section-paper">
      <div class="section-shell case-grid" id="teil-1" data-reveal>
        <h2><span class="case-num">01</span>{study.situation.title}</h2>
        <div class="case-prose">{study.situation.paras.map((p) => <p>{p}</p>)}</div>
      </div>

      <figure class={`section-shell case-flow is-${v.flow.kind}`} data-reveal data-stagger>
        <figcaption>
          <span>{v.flow.title}</span>
          {v.flow.kind === 'flow' && <span class="case-flow-legend"><i class="is-human"></i>{t.human}<i class="is-ai"></i>{t.ai}</span>}
        </figcaption>
        <ol>
          {v.flow.nodes.map(([title, sub, who], i) => (
            <li class={`is-${who}`} style={`--i:${i}; --n:${v.flow.kind === 'timeline' ? Math.round((i + 1) * 5 / v.flow.nodes.length) : 5}`}>
              {v.flow.kind === 'flow' && who !== 'neutral' && <em>{who === 'ai' ? t.ai : t.human}</em>}
              <strong>{title}</strong><span>{sub}</span>
            </li>
          ))}
        </ol>
      </figure>

      <div class="section-shell case-grid" id="teil-2" data-reveal>
        <h2><span class="case-num">02</span>{study.steps!.title}</h2>
        <ol class="case-steps" data-reveal data-stagger>
          {study.steps!.items.map(([title, body], i) => (
            <li style={`--i:${i}; --n:${Math.min(i + 1, 5)}`}><b aria-hidden="true">{i + 1}</b><div><h3>{title}</h3><p>{body}</p></div></li>
          ))}
        </ol>
      </div>

      {study.images && (
        <div class="section-shell case-images" data-reveal>
          {study.images.map((img, i) => (
            <figure style={`--tilt:${i % 2 ? 1 : -1}deg`}>
              <img src={img.src} alt={img.alt} width={img.width} height={img.height} loading="lazy" />
              <figcaption>{img.caption}</figcaption>
            </figure>
          ))}
        </div>
      )}

      <blockquote class="section-shell case-quote" data-reveal>
        <p>{v.quote.text}</p>
        <cite>{v.quote.by}</cite>
      </blockquote>
    </section>

    )}

    <section class="case-result section-dark" id={`teil-${resultNum}`}>
      <div class="section-shell case-grid" data-reveal>
        <div>
          <p class="section-label"><span class="case-num">{pad(resultNum)}</span> {study.result.title}</p>
          <p class="case-big">{study.result.big}</p>
          <p class="case-big-label">{study.result.bigLabel}</p>
        </div>
        <div>
          <ul class="case-result-list">{study.result.items.map((item) => <li>{item}</li>)}</ul>
          {study.result.note && <p class="case-note">{study.result.note}</p>}
        </div>
      </div>
    </section>

    <section class="case-compare section-paper">
      <div class="section-shell" data-reveal>
        <p class="section-label">{v.compare.title}</p>
        <div class="case-compare-grid">
          <div class="is-before"><h3>{v.compare.beforeTitle}</h3><ul>{v.compare.before.map((x) => <li>{x}</li>)}</ul></div>
          <div class="case-compare-arrow" aria-hidden="true">→</div>
          <div class="is-after"><h3>{v.compare.afterTitle}</h3><ul>{v.compare.after.map((x) => <li>{x}</li>)}</ul></div>
        </div>
      </div>
    </section>

    {article ? (
      <Fragment>
    {study.callback && (
      <section class="case-callback section-paper">
        <div class="section-shell case-grid" data-reveal>
          <h2>{study.callback.title}</h2>
          <div class="case-prose">{study.callback.paras.map((p) => <p>{p}</p>)}</div>
        </div>
      </section>
    )}

    {study.takeaways && (
      <section class="case-transfer case-takeaways-section section-light" id={`teil-${resultNum + 1}`}>
        <div class="section-shell case-grid" data-reveal>
          <h2><span class="case-num">{pad(resultNum + 1)}</span>{study.takeaways.title}</h2>
          <div>
            <ol class="case-takeaways" data-reveal data-stagger>
              {study.takeaways.items.map(([head, body], i) => (
                <li style={`--i:${i}`}><b aria-hidden="true">{i + 1}</b><div><h3>{head}</h3><p>{body}</p></div></li>
              ))}
            </ol>
            <p class="case-notfit"><strong>{study.takeaways.notFitLabel}:</strong> {study.takeaways.notFit}</p>
          </div>
        </div>
        {study.questions && (
          <div class="section-shell case-grid case-questions" data-reveal>
            <h3>{study.questions.title}</h3>
            <ul>{study.questions.items.map((q) => <li>{q}</li>)}</ul>
          </div>
        )}
      </section>
    )}

      </Fragment>
    ) : (
    <section class="case-transfer section-light" id="teil-4">
      <div class="section-shell case-grid" data-reveal>
        <h2><span class="case-num">04</span>{study.transfer!.title}</h2>
        <div>
          <p class="lead">{study.transfer!.body}</p>
          <ul class="case-chips">{study.transfer!.examples.map((e) => <li>{e}</li>)}</ul>
        </div>
      </div>
      <div class="section-shell case-grid case-limits" data-reveal>
        <h3>{study.limits!.title}</h3>
        <ul>{study.limits!.items.map((item) => <li>{item}</li>)}</ul>
      </div>
    </section>

    )}

    <section class="contact leadership-contact section-dark">
      <div class="section-shell contact-inner" data-reveal>
        <h2>{ctaTitle}</h2>
        <p>{ctaBody}</p>
        <div class="contact-actions">
          <a class="button button-primary" href={bookUrl} target="_blank" rel="noopener">{t.book}</a>
          <a class="contact-link" href={`mailto:tobias@treppmann.de?subject=${encodeURIComponent(t.subject + study.label)}`}>tobias@treppmann.de<span aria-hidden="true">↗︎</span></a>
        </div>
      </div>
    </section>

    <section class="case-more section-paper" aria-labelledby="more-title">
      <div class="section-shell">
        <p class="section-label" id="more-title">{t.more}</p>
        <div class="case-more-grid">
          {others.map((s) => (
            <a class="case-more-card" href={`${base}${s.slug}/`}>
              <figure class={`collage-object collage-object-small shape-${s.shape}`} aria-hidden="true"><img src={`/images/collage/${s.object}.webp`} alt="" loading="lazy" /></figure>
              <div><p class="tool-meta">{s.label}</p><h3>{s.title}</h3><span class="tool-action">{t.read}<span aria-hidden="true"> →</span></span></div>
            </a>
          ))}
        </div>
      </div>
    </section>
  </main>

  <footer class="leadership-footer">
    <span>Tobias Treppmann · {t.suffix}</span>
    <div class="footer-links">
      <a href="/impressum/">{t.impressum}</a>
      <a href="/datenschutz/">{t.privacy}</a>
      <a href={de ? '/gekauft-ist-nicht-eingefuehrt/' : '/en/report/'}>Report</a>
      <a href={de ? '/ki-check/' : '/en/ai-check/'}>{de ? 'KI-Check' : 'AI check'}</a>
      <a href={home}>{t.homeLink}</a>
    </div>
  </footer>

  <script is:inline>
    (function () {
      if (matchMedia('(prefers-reduced-motion: reduce)').matches || !('IntersectionObserver' in window)) return;
      document.documentElement.classList.add('has-motion');
      var io = new IntersectionObserver(function (es) { es.forEach(function (e) { if (e.isIntersecting) { e.target.classList.add('is-visible'); io.unobserve(e.target); } }); }, { threshold: .15 });
      document.querySelectorAll('[data-reveal]').forEach(function (el) { io.observe(el); });
    })();
  </script>
</Layout>
