---
import Layout from '../../../src/layouts/Layout.astro';

const url = 'https://treppmann.de/ki-check/';
const title = 'KI-Check: Wo steht Ihr Unternehmen?';
const description = 'Zehn Fragen, drei Minuten: Auf welcher Stufe der KI-Einführung steht Ihr Unternehmen, und was wäre der nächste sinnvolle Schritt?';
const bookUrl = 'https://fantastical.app/tobiastreppmann';

// Each dimension is one observation from the report "Gekauft ist nicht eingeführt".
const dimensions = [
  { id: 'use', name: 'Nutzung', advice: 'Zugang ist noch keine Nutzung. Suchen Sie einen Ablauf, in dem viele Leute täglich dieselbe mühsame Arbeit machen, und bringen Sie KI genau dort hinein, statt sie allen für alles anzubieten.' },
  { id: 'process', name: 'Prozess', advice: 'Beginnen Sie mit einem Prozess, nicht mit einer Liste von Use Cases: einem, der häufig vorkommt, Zeit kostet und klar genug ist, um ihn umzubauen. Schauen Sie zuerst, wie die Arbeit heute wirklich läuft.' },
  { id: 'owner', name: 'Verantwortung', advice: 'Benennen Sie eine Person mit Mandat und Zeit. Sie setzt Prioritäten, zieht den ersten Prozess durch und berichtet, was er gebracht hat. Eine neue Abteilung braucht es dafür nicht.' },
  { id: 'enable', name: 'Befähigung', advice: 'Schulungen allein reichen selten. Lassen Sie Menschen KI an ihrer eigenen Aufgabe erleben, mit jemandem an ihrer Seite, und geben Sie ein, zwei Botschaftern festes Zeitbudget. Seit Februar 2025 verpflichtet Art. 4 der KI-Verordnung Unternehmen, die KI einsetzen, ohnehin, für ausreichende KI-Kompetenz zu sorgen.' },
  { id: 'measure', name: 'Messen', advice: 'Legen Sie vor dem nächsten Vorhaben fest, woran Sie den Erfolg messen, etwa Zeit pro Vorgang oder Anteil der regelmäßigen Nutzer, und halten Sie den Ausgangswert fest. Nach rund 90 Tagen nachsehen.' },
];

// Options run from 0 to 3 points. Wording stays neutral so the "right" answer is not obvious.
const questions = [
  { dim: 'use', q: 'Wie viele Ihrer Beschäftigten nutzen KI mindestens einmal pro Woche für ihre Arbeit?', a: ['Kaum jemand, oder wir wissen es nicht', 'Einzelne Interessierte', 'Ganze Teams in einzelnen Bereichen', 'Die meisten, in vielen Bereichen'] },
  { dim: 'use', q: 'Welche KI-Werkzeuge stellt Ihr Unternehmen bereit?', a: ['Keine; wer KI nutzt, nutzt private Konten', 'Ein Chat-Werkzeug wie ChatGPT oder Copilot für einzelne', 'Ein Chat-Werkzeug für alle, mit Firmenkonto', 'Dazu Werkzeuge, die auf bestimmte Aufgaben zugeschnitten sind'] },
  { dim: 'process', q: 'Gibt es einen Arbeitsablauf, der mit KI neu gestaltet wurde, nicht nur ergänzt?', a: ['Nein', 'Wir planen das', 'Ja, einen', 'Ja, mehrere'] },
  { dim: 'process', q: 'Wie entstehen bei Ihnen KI-Vorhaben?', a: ['Bisher gar nicht, oder jeder probiert für sich', 'Aus einer Sammlung von Ideen und Use Cases', 'Ausgewählt nach Nutzen und Aufwand', 'Ausgehend von konkreten Engpässen in Abläufen'] },
  { dim: 'owner', q: 'Wer ist bei Ihnen für KI verantwortlich?', a: ['Niemand ausdrücklich', 'Die IT oder Interessierte, nebenbei', 'Eine benannte Person, ohne festes Zeitbudget', 'Eine Person mit Mandat und Zeit dafür'] },
  { dim: 'owner', q: 'Gibt es Regeln, wie KI bei Ihnen genutzt werden darf?', a: ['Nein', 'Ungeschrieben, man weiß es ungefähr', 'Eine schriftliche KI-Leitlinie', 'Eine Leitlinie, die bekannt ist und im Alltag angewendet wird'] },
  { dim: 'enable', q: 'Wie lernen Ihre Leute, mit KI zu arbeiten?', a: ['Bisher gar nicht', 'Jeder für sich', 'In Schulungen', 'Begleitet an ihren eigenen Aufgaben'] },
  { dim: 'enable', q: 'Gibt es Menschen im Team, die andere bei KI mitnehmen?', a: ['Nein', 'Ein paar Interessierte, inoffiziell', 'Benannte Ansprechpartner', 'KI-Botschafter mit festem Zeitbudget'] },
  { dim: 'measure', q: 'Wissen Sie, was KI Ihnen bisher bringt?', a: ['Nein', 'Wir haben einen Eindruck', 'An einzelnen Beispielen', 'Ja, gemessen gegen einen Ausgangswert'] },
  { dim: 'measure', q: 'Legen Sie vor einem KI-Vorhaben fest, woran der Erfolg gemessen wird?', a: ['Nie, oder es gab noch keine Vorhaben', 'Manchmal', 'Meistens', 'Immer'] },
];

// Points decide the stage, but a stage name is a claim about the company, so some stages need
// specific answers: "Ausprobiert" needs some use, "Ein Prozess läuft anders" needs a redesigned
// process, "Teil der Arbeitsweise" needs several processes and real measurement.
const stages = [
  { max: 6, name: 'Gekauft', text: 'KI ist da, als Lizenz oder als privates Werkzeug, aber sie verändert noch nichts an der Arbeit. Damit sind Sie in großer Gesellschaft: In der Bitkom-Befragung vom September 2026 sagte kein einziges KI-nutzendes Unternehmen, es schöpfe das Potenzial voll aus.', textNone: 'KI spielt bei Ihnen noch keine Rolle. Das ist ein guter Ausgangspunkt: Sie können mit einem Prozess anfangen statt mit einer Lizenz, und die typischen Fehler der anderen überspringen.' },
  { max: 12, name: 'Ausprobiert', text: 'Einzelne nutzen KI, oft mit Begeisterung, aber zufällig verteilt. Was fehlt, ist der Schritt von „man kann“ zu „wir machen es so“.' },
  { max: 18, name: 'Erste Vorhaben', text: 'Es gibt Vorhaben und Ansätze von Struktur. Jetzt entscheidet sich, ob daraus ein Prozess wird, der wirklich anders läuft, oder eine weitere Sammlung von Piloten.' },
  { max: 24, name: 'Ein Prozess läuft anders', text: 'Mindestens ein Ablauf ist mit KI neu gestaltet. Die Aufgabe ist jetzt, das Gelernte auf den nächsten Prozess zu übertragen und den Nutzen sichtbar zu machen.' },
  { max: 30, name: 'Teil der Arbeitsweise', text: 'KI ist in mehreren Prozessen verankert, verantwortet und gemessen. Das ist selten: In der Bitkom-Befragung sagten nur 3 Prozent der KI-Anwender, sie schöpften das Potenzial eher stark aus. Hier geht es um Tiefe: eigene Daten, eigene Werkzeuge, mehr Menschen, die selbst bauen.' },
];

const structuredData = {
  '@context': 'https://schema.org',
  '@type': 'WebPage',
  name: title,
  description,
  inLanguage: 'de-DE',
  author: { '@type': 'Person', name: 'Tobias Treppmann', url: 'https://treppmann.de/' },
  url,
};
---

<Layout lang="de-DE" title={`${title} – Tobias Treppmann`} description={description} canonical={url} alternateDe={url} alternateEn={url} alternateDefault={url} image="https://treppmann.de/images/tobias-treppmann.jpg" structuredData={structuredData}>
  <a class="skip-link" href="#main">Zum Inhalt springen</a>
  <header class="topbar leadership-topbar">
    <a class="brand" href="/" aria-label="Tobias Treppmann – Startseite">
      <span>Tobias Treppmann</span><span class="brand-mark">/</span><span>KI-Transformation</span>
    </a>
    <div class="topbar-actions">
      <a class="topbar-contact" href="/#contact">Kontakt</a>
    </div>
  </header>

  <main class="check-page section-paper" id="main">
    <div class="section-shell check-shell">
      <section class="check-intro" id="check-intro">
        <p class="section-label">KI-Check · 3 Minuten</p>
        <h1>Wo steht Ihr Unternehmen mit KI?</h1>
        <p class="check-lead">Zehn Fragen zu Nutzung, Prozessen, Verantwortung, Befähigung und Messen. Am Ende sehen Sie, auf welcher von fünf Stufen Sie stehen und was der nächste sinnvolle Schritt wäre.</p>
        <ol class="check-stage-preview" aria-label="Die fünf Stufen">
          {stages.map((s, i) => <li><span>{i + 1}</span>{s.name}</li>)}
        </ol>
        <button class="button button-primary check-start" type="button" data-start>Check starten <span aria-hidden="true">→</span></button>
        <p class="check-privacy">Ihre Antworten bleiben in Ihrem Browser. Gespeichert oder übertragen wird nichts.</p>
        <noscript><p class="check-privacy">Der Check braucht JavaScript. Die Fragen und Stufen beruhen auf meinem Report <a href="/gekauft-ist-nicht-eingefuehrt/">„Gekauft ist nicht eingeführt“</a>.</p></noscript>
      </section>

      <form class="check-quiz" id="check-quiz" hidden>
        <div class="check-progress" aria-hidden="true"><span data-bar></span></div>
        <p class="check-count" aria-live="polite"><span data-count>1</span> von {questions.length}</p>
        <div class="check-stack">
          {questions.map((item, qi) => (
            <fieldset class="check-question" data-q={qi} data-dim={item.dim} inert>
              <legend><span class="check-dim">{dimensions.find((d) => d.id === item.dim)!.name}</span>{item.q}</legend>
              <div class="check-options">
                {item.a.map((label, ai) => (
                  <label class="check-option">
                    <input type="radio" name={`q${qi}`} value={ai} />
                    <span class="check-option-mark" aria-hidden="true"></span>
                    <span>{label}</span>
                  </label>
                ))}
              </div>
            </fieldset>
          ))}
        </div>
        <div class="check-nav">
          <button class="check-back" type="button" data-back>← Zurück</button>
          <button class="button button-ink check-next" type="button" data-next disabled>Weiter <span aria-hidden="true">→</span></button>
        </div>
      </form>

      <section class="check-result" id="check-result" hidden tabindex="-1" aria-labelledby="result-title">
        <p class="section-label">Ihr Ergebnis</p>
        <ol class="check-ladder" aria-hidden="true">
          {stages.map((s, i) => <li data-stage={i}><span>{i + 1}</span>{s.name}</li>)}
        </ol>
        <h2 id="result-title">Stufe <span data-stage-num></span>: <span data-stage-name></span></h2>
        <p class="check-lead" data-stage-text></p>

        <h3>Ihr Profil</h3>
        <ul class="check-profile">
          {dimensions.map((d) => (
            <li data-dim-row={d.id}>
              <span class="check-profile-name">{d.name}</span>
              <span class="check-profile-track"><span class="check-profile-fill"></span></span>
              <span class="check-profile-value" data-dim-value></span>
            </li>
          ))}
        </ul>

        <h3>Wo ich ansetzen würde</h3>
        <div class="check-advice" data-advice></div>

        <div class="report-cta">
          <p><strong>Sie wollen wissen, wie das bei Ihnen konkret aussehen könnte?</strong> In 30 Minuten schauen wir gemeinsam auf Ihre Situation und den ersten Ansatzpunkt.</p>
          <a class="button button-ink" href={bookUrl} target="_blank" rel="noopener">Erstgespräch buchen<span aria-hidden="true"> ↗</span></a>
          <p class="report-cta-alt">Hintergrund: <a href="/gekauft-ist-nicht-eingefuehrt/">Report „Gekauft ist nicht eingeführt“</a> · <a href="/">Wie ich arbeite</a></p>
        </div>

        <p class="check-actions">
          <button class="check-back" type="button" data-restart>Check neu starten</button>
          <a class="check-share" href={`https://www.linkedin.com/sharing/share-offsite/?url=${encodeURIComponent(url)}`} target="_blank" rel="noopener">Check auf LinkedIn teilen ↗</a>
        </p>
        <p class="check-privacy">Eine Orientierung, kein Gutachten. Die Fragen beruhen auf den fünf Beobachtungen aus meinem Report.</p>
      </section>
    </div>
  </main>

  <footer class="leadership-footer">
    <span>Tobias Treppmann · KI-Transformation</span>
    <div class="footer-links">
      <a href="/impressum/">Impressum</a>
      <a href="/datenschutz/">Datenschutz</a>
      <a href="/">Startseite</a>
    </div>
  </footer>

  <script is:inline define:vars={{ dimensions, stages, total: questions.length }}>
    const intro = document.getElementById('check-intro');
    const quiz = document.getElementById('check-quiz');
    const result = document.getElementById('check-result');
    const qs = [...quiz.querySelectorAll('.check-question')];
    const bar = quiz.querySelector('[data-bar]');
    const count = quiz.querySelector('[data-count]');
    const back = quiz.querySelector('[data-back]');
    const nextBtn = quiz.querySelector('[data-next]');
    const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    const ease = 'cubic-bezier(.2,.7,.2,1)';
    let current = -1;
    let busy = false;
    let pointer = false;

    const fade = (el, frames, duration) => reduce
      ? Promise.resolve()
      : el.animate(frames, { duration, easing: ease, fill: 'both' }).finished;
    const out = (el, dx = 0) => fade(el, [{ opacity: 1, transform: 'none' }, { opacity: 0, transform: `translate(${-dx}px, ${dx ? 0 : -8}px)` }], 200);
    const into = (el, dx = 0) => fade(el, [{ opacity: 0, transform: `translate(${dx}px, ${dx ? 0 : 12}px)` }, { opacity: 1, transform: 'none' }], 380);
    const toTop = () => {
      const top = document.getElementById('main').getBoundingClientRect().top + window.scrollY;
      if (window.scrollY > top + 4) window.scrollTo({ top, behavior: reduce ? 'auto' : 'smooth' });
    };

    function activate(q, on) {
      q.inert = !on;
      q.classList.toggle('is-current', on);
    }

    async function go(i, dir = 1) {
      if (busy || i === current) return;
      busy = true;
      const from = qs[current];
      const to = qs[i];
      count.textContent = String(i + 1);
      bar.style.width = `${(i / total) * 100}%`;
      back.style.visibility = i === 0 ? 'hidden' : 'visible';
      nextBtn.disabled = !to.querySelector('input:checked');
      if (from) { await out(from, 28 * dir); activate(from, false); from.getAnimations().forEach((a) => a.cancel()); }
      activate(to, true);
      current = i;
      const focusTarget = to.querySelector('input:checked') || to.querySelector('input');
      focusTarget.focus({ preventScroll: true });
      await into(to, 28 * dir);
      to.getAnimations().forEach((a) => a.cancel());
      busy = false;
    }

    function score() {
      const per = {};
      dimensions.forEach((d) => { per[d.id] = 0; });
      let sum = 0;
      const answers = qs.map((q) => Number(q.querySelector('input:checked')?.value || 0));
      qs.forEach((q, n) => { per[q.dataset.dim] += answers[n]; sum += answers[n]; });
      let idx = stages.findIndex((s) => sum <= s.max);
      // A stage name must not contradict the answers.
      const redesigned = answers[2];
      if (answers[0] === 0) idx = Math.min(idx, 0);
      if (redesigned < 2) idx = Math.min(idx, 2);
      if (redesigned < 3 || per.measure < 4) idx = Math.min(idx, 3);
      const none = answers[0] === 0 && answers[1] === 0;
      return { per, idx, none };
    }

    async function finish() {
      if (busy) return;
      busy = true;
      bar.style.width = '100%';
      const { per, idx, none } = score();
      const stage = stages[idx];
      result.querySelector('[data-stage-num]').textContent = String(idx + 1);
      result.querySelector('[data-stage-name]').textContent = idx === 0 && none ? 'Noch am Anfang' : stage.name;
      result.querySelector('[data-stage-text]').textContent = idx === 0 && none ? stage.textNone : stage.text;
      result.querySelectorAll('[data-stage]').forEach((li) => {
        const n = Number(li.dataset.stage);
        li.classList.toggle('is-reached', n <= idx);
        li.classList.toggle('is-current', n === idx);
      });
      dimensions.forEach((d) => {
        const row = result.querySelector(`[data-dim-row="${d.id}"]`);
        row.querySelector('[data-dim-value]').textContent = `${per[d.id]} / 6`;
        row.querySelector('.check-profile-fill').style.setProperty('--w', `${Math.round((per[d.id] / 6) * 100)}%`);
      });
      const weakest = [...dimensions].sort((a, b) => per[a.id] - per[b.id]).filter((d) => per[d.id] < 6).slice(0, 2);
      const advice = result.querySelector('[data-advice]');
      advice.innerHTML = '';
      if (!weakest.length) {
        const p = document.createElement('p');
        p.textContent = 'In allen fünf Bereichen sind Sie weit. Spannend wird jetzt, wo sich KI noch tiefer in Ihre Prozesse und Produkte einbauen lässt.';
        advice.append(p);
      }
      weakest.forEach((d) => {
        const div = document.createElement('div');
        div.className = 'check-advice-item';
        const h = document.createElement('h4'); h.textContent = d.name;
        const p = document.createElement('p'); p.textContent = d.advice;
        div.append(h, p); advice.append(div);
      });
      await out(quiz);
      quiz.hidden = true;
      quiz.getAnimations().forEach((a) => a.cancel());
      result.classList.remove('is-revealed');
      result.hidden = false;
      toTop();
      result.focus({ preventScroll: true });
      requestAnimationFrame(() => result.classList.add('is-revealed'));
      await into(result);
      busy = false;
    }

    async function start() {
      await out(intro);
      intro.hidden = true;
      quiz.hidden = false;
      qs.forEach((q) => activate(q, false));
      current = -1;
      toTop();
      await into(quiz.querySelector('.check-progress'));
      go(0);
    }

    const advance = () => (current + 1 < total ? go(current + 1) : finish());
    document.querySelector('[data-start]').addEventListener('click', start);
    quiz.addEventListener('pointerdown', () => { pointer = true; });
    quiz.addEventListener('keydown', (e) => {
      pointer = false;
      if (e.key === 'Enter' && qs[current]?.querySelector('input:checked')) { e.preventDefault(); advance(); }
    });
    // Mouse and touch answers move on by themselves; keyboard users continue with Enter or the button.
    quiz.addEventListener('change', (e) => {
      if (!(e.target instanceof HTMLInputElement)) return;
      nextBtn.disabled = false;
      if (pointer) setTimeout(advance, reduce ? 0 : 380);
    });
    quiz.addEventListener('submit', (e) => e.preventDefault());
    nextBtn.addEventListener('click', advance);
    back.addEventListener('click', () => { if (current > 0) go(current - 1, -1); });
    result.querySelector('[data-restart]').addEventListener('click', async () => {
      await out(result);
      result.hidden = true;
      result.getAnimations().forEach((a) => a.cancel());
      quiz.reset();
      quiz.hidden = false;
      qs.forEach((q) => activate(q, false));
      current = -1;
      toTop();
      go(0);
    });
  </script>
</Layout>
