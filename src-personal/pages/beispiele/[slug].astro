---
import Layout from '../../../src/layouts/Layout.astro';
import { caseStudies, type CaseStudy } from '../../caseStudies';

export function getStaticPaths() {
  return caseStudies.map((study) => ({ params: { slug: study.slug }, props: { study } }));
}

interface Props { study: CaseStudy }
const { study } = Astro.props;
const url = `https://treppmann.de/beispiele/${study.slug}/`;
const bookUrl = 'https://fantastical.app/tobiastreppmann';
const others = caseStudies.filter((s) => s.slug !== study.slug);
const structuredData = {
  '@context': 'https://schema.org',
  '@type': 'Article',
  headline: study.title,
  description: study.description,
  inLanguage: 'de-DE',
  author: { '@type': 'Person', name: 'Tobias Treppmann', url: 'https://treppmann.de/' },
  mainEntityOfPage: url,
};
---

<Layout lang="de-DE" title={`${study.title} – Tobias Treppmann`} description={study.description} canonical={url} alternateDe={url} alternateEn={url} alternateDefault={url} image="https://treppmann.de/images/tobias-treppmann.jpg" structuredData={structuredData}>
  <a class="skip-link" href="#main">Zum Inhalt springen</a>
  <header class="topbar leadership-topbar">
    <a class="brand" href="/" aria-label="Tobias Treppmann – Startseite">
      <span>Tobias Treppmann</span><span class="brand-mark">/</span><span>KI-Transformation</span>
    </a>
    <div class="topbar-actions">
      <a class="topbar-contact" href="/#contact">Kontakt</a>
      <a class="language" href="/en/" lang="en">EN</a>
    </div>
  </header>

  <main class="case-page" id="main">
    <section class="case-hero section-dark">
      <div class="section-shell case-hero-shell">
        <div>
          <p class="case-back"><a href="/#proof"><span aria-hidden="true">← </span>Alle Beispiele</a></p>
          <p class="section-label">Beispiel · {study.label}</p>
          <h1>{study.title}</h1>
          <p class="case-lead">{study.lead}</p>
        </div>
        <figure class={`collage-object case-hero-object shape-${study.shape}`} aria-hidden="true">
          <img src={`/images/collage/${study.object}.webp`} alt="" />
        </figure>
      </div>
    </section>

    <section class="case-facts section-paper" aria-label="Auf einen Blick">
      <dl class="section-shell case-facts-list" data-reveal data-stagger>
        {study.facts.map(([k, v], i) => (
          <div style={`--i:${i}`}><dt>{k}</dt><dd>{v}</dd></div>
        ))}
      </dl>
    </section>

    <section class="case-body section-paper">
      <div class="section-shell case-grid" data-reveal>
        <h2>{study.situation.title}</h2>
        <div class="case-prose">{study.situation.paras.map((p) => <p>{p}</p>)}</div>
      </div>

      <div class="section-shell case-grid" data-reveal>
        <h2>{study.steps.title}</h2>
        <ol class="case-steps" data-reveal data-stagger>
          {study.steps.items.map(([title, body], i) => (
            <li style={`--i:${i}; --n:${Math.min(i + 1, 5)}`}><b aria-hidden="true">{i + 1}</b><div><h3>{title}</h3><p>{body}</p></div></li>
          ))}
        </ol>
      </div>

      {study.images && (
        <div class="section-shell case-images" data-reveal>
          {study.images.map((img, i) => (
            <figure style={`--tilt:${i % 2 ? 1 : -1}deg`}>
              <img src={img.src} alt={img.alt} width={img.width} height={img.height} loading="lazy" />
              <figcaption>{img.caption}</figcaption>
            </figure>
          ))}
        </div>
      )}
    </section>

    <section class="case-result section-dark">
      <div class="section-shell case-grid" data-reveal>
        <div>
          <p class="section-label">{study.result.title}</p>
          <p class="case-big">{study.result.big}</p>
          <p class="case-big-label">{study.result.bigLabel}</p>
        </div>
        <div>
          <ul class="case-result-list">{study.result.items.map((item) => <li>{item}</li>)}</ul>
          {study.result.note && <p class="case-note">{study.result.note}</p>}
        </div>
      </div>
    </section>

    <section class="case-transfer section-light">
      <div class="section-shell case-grid" data-reveal>
        <h2>{study.transfer.title}</h2>
        <div>
          <p class="lead">{study.transfer.body}</p>
          <ul class="case-chips">{study.transfer.examples.map((e) => <li>{e}</li>)}</ul>
        </div>
      </div>
      <div class="section-shell case-grid case-limits" data-reveal>
        <h3>{study.limits.title}</h3>
        <ul>{study.limits.items.map((item) => <li>{item}</li>)}</ul>
      </div>
    </section>

    <section class="contact leadership-contact section-dark">
      <div class="section-shell contact-inner" data-reveal>
        <h2>Welcher Prozess soll bei Ihnen als Erstes besser werden?</h2>
        <p>In 30 Minuten sprechen wir darüber, wo KI bei Ihnen ansetzen könnte. Kostenlos und ohne Verpflichtung.</p>
        <div class="contact-actions">
          <a class="button button-primary" href={bookUrl} target="_blank" rel="noopener">Erstgespräch vereinbaren</a>
          <a class="contact-link" href={`mailto:tobias@treppmann.de?subject=${encodeURIComponent('Beispiel: ' + study.label)}`}>tobias@treppmann.de<span aria-hidden="true">↗︎</span></a>
        </div>
      </div>
    </section>

    <section class="case-more section-paper" aria-labelledby="more-title">
      <div class="section-shell">
        <p class="section-label" id="more-title">Weitere Beispiele</p>
        <div class="case-more-grid">
          {others.map((s) => (
            <a class="case-more-card" href={`/beispiele/${s.slug}/`}>
              <figure class={`collage-object collage-object-small shape-${s.shape}`} aria-hidden="true"><img src={`/images/collage/${s.object}.webp`} alt="" loading="lazy" /></figure>
              <div><p class="tool-meta">{s.label}</p><h3>{s.title}</h3><span class="tool-action">Beispiel lesen<span aria-hidden="true"> →</span></span></div>
            </a>
          ))}
        </div>
      </div>
    </section>
  </main>

  <footer class="leadership-footer">
    <span>Tobias Treppmann · KI-Transformation</span>
    <div class="footer-links">
      <a href="/impressum/">Impressum</a>
      <a href="/datenschutz/">Datenschutz</a>
      <a href="/gekauft-ist-nicht-eingefuehrt/">Report</a>
      <a href="/ki-check/">KI-Check</a>
      <a href="/">Startseite</a>
    </div>
  </footer>

  <script is:inline>
    (function () {
      if (matchMedia('(prefers-reduced-motion: reduce)').matches || !('IntersectionObserver' in window)) return;
      document.documentElement.classList.add('has-motion');
      var io = new IntersectionObserver(function (es) { es.forEach(function (e) { if (e.isIntersecting) { e.target.classList.add('is-visible'); io.unobserve(e.target); } }); }, { threshold: .15 });
      document.querySelectorAll('[data-reveal]').forEach(function (el) { io.observe(el); });
    })();
  </script>
</Layout>
