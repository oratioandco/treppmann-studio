---
import Layout from '../../../src/layouts/Layout.astro';

// Bewerbungsseite für den rbb, Leitung UX + Produktivität (Kennziffer 142/2026).
// Rewritten 2026-11-16 from scratch after Tobias's review: applicant page, not
// a consulting page. Neutral site palette, plain portrait, plain headings, no
// sales close, no links to service pages. Every fact mirrors the gated English
// CV in my-cv-tailor (data/applications/rbb-leitung-ux-produktivitaet/
// cv-content.yaml); hedges travel with their facts. This German text is
// authored directly, so the gate's English-only rules cannot judge it.
const canonical = 'https://treppmann.de/for/rbb/';
const email = 'tobias@treppmann.de';
const cvHref = '/downloads/Tobias-Treppmann-CV-rbb.pdf';
const mailto = `mailto:${email}?subject=${encodeURIComponent('Bewerbung Leitung UX + Produktivität (142/2026)')}`;

const work = [
  {
    tag: 'Bibel TV · seit 2025',
    title: 'Ein KI-Assistent für den Zuschauerservice',
    body: [
      'Der Zuschauerservice von Bibel TV beantwortet vor allem Briefe. Im September und Oktober 2025 habe ich dafür einen Assistenten in Microsoft Copilot gebaut. Er schreibt Antwortentwürfe mit den Formulierungen des Service-Handbuchs. Ein Mensch liest jeden Brief, bearbeitet den Entwurf und entscheidet, ob die Antwort verschickt wird.',
      'Die Einführung habe ich selbst übernommen. Die Nutzung war freiwillig, es gab eine Testwoche und danach Einzelgespräche. Nach Auskunft des Teams wird der Assistent heute regelmäßig genutzt, wenn auch nicht für jeden Brief. Auch zwei Mitarbeitende, die anfangs skeptisch waren, arbeiten damit.',
      'Für komplexe Briefe braucht das Team nach eigener Aussage heute Minuten, früher waren es Stunden. Teilzeitkräfte treffen den Ton des Hauses von Anfang an.',
    ],
    href: 'https://treppmann.design/case-studies/bibeltv-support-agent/',
  },
  {
    tag: 'Bibel TV · 2026',
    title: 'Clips aus Predigtvideos für eine Studienbibel-App',
    body: [
      'Für eine KI-Studienbibel-App von Bibel TV habe ich mit KI-Agenten eine Pipeline in n8n aufgebaut und betrieben. Sie transkribiert Predigtvideos und macht daraus Clips zu einzelnen Bibelstellen. Neue Videos kommen jede Nacht dazu. Am 9. Oktober 2026 waren es 11.405 Clips aus 3.504 Videos.',
      'Die App mit ihrer Chatfunktion habe ich ebenfalls selbst gebaut. Dabei habe ich besonders auf die Anforderungen der KI-Verordnung der EU (AI Act) geachtet.',
    ],
    href: 'https://treppmann.design/case-studies/bibeltv-metadata-extraction/',
  },
  {
    tag: 'Bibel TV · 2026',
    title: 'KI-Schulungen für Produktmanagement und Product Owner',
    body: [
      'Ich habe das Produktmanagement und die Product Owner darin geschult, mit KI selbst Software zu bauen, meist einzeln. Das Team arbeitet mit Claude Code, mit Spec Kit auf GitHub und mit MCP-Servern für die interne Dokumentation.',
      'Der Großteil des Backends entsteht inzwischen im Haus statt bei einer externen Agentur. Auf Grundlage dieser Arbeit hat der CEO entschieden, die App ohne die Agentur neu zu bauen.',
    ],
    href: 'https://treppmann.design/case-studies/bibeltv-ai-prototyping/',
  },
];

const experience = [
  {
    years: '2025 – heute',
    role: 'Head of Product Design',
    org: 'Bibel TV, Hamburg und Berlin',
    note: 'Produktmanagement und Product Ownership für die Neugestaltung der App. Die externe Entwicklung steuere ich über das Ticketsystem.',
  },
  {
    years: '2024 – 2025',
    role: 'Head of Platform and Design',
    org: 'ChurchDesk, Berlin',
    note: 'Produktmanagement für die Hauptplattform und das gesamte Produktdesign in sechs Ländern. Den Barrierefreiheits-Audit zum European Accessibility Act geleitet. Zu den Korrekturen gehörte eine KI-Funktion, die Alternativtexte für Bilder erzeugt und DSGVO sowie kirchliches Datenschutzrecht einhält.',
  },
  {
    years: '2023 – 2024',
    role: 'Head of Product Design, Interim Head of Product',
    org: 'Ninox Software GmbH, Berlin',
    note: 'Mitglied im Senior Leadership Team. Fünf Mitarbeitende in Produktdesign und UX Writing geführt. Von Juli bis Oktober 2023 zugleich Interim Head of Product, mit insgesamt neun Mitarbeitenden aus Produktmanagement, Data Science, Design und UX Writing. Ein Leveling-Framework geschrieben, zwei Personen eingestellt und zwei befördert.',
  },
  {
    years: '2021 – 2022',
    role: 'Product & UX Strategist',
    org: 'Hypoport hub SE, Berlin',
    note: 'Mit der Geschäftsleitung interne Dienstleistungen zu Produkten weiterentwickelt. Design-Thinking-Trainings für die Geschäftsleitung und die Service-Teams gegeben.',
  },
  {
    years: '2016 – 2021',
    role: 'Director of Design',
    org: 'Datameer GmbH, Berlin',
    note: 'Von Berlin aus ein UX-Team geleitet. Zwei Mitarbeitende im UX-Design waren mir direkt unterstellt, ein Teil des Teams saß in New York.',
  },
  {
    years: '2014 – 2016',
    role: 'UX Strategy Lead',
    org: 'Spreadshirt, Leipzig',
    note: '',
  },
];

const structuredData = {
  '@context': 'https://schema.org',
  '@type': 'ProfilePage',
  name: 'Tobias Treppmann: Bewerbung beim rbb',
  url: canonical,
  mainEntity: {
    '@type': 'Person',
    name: 'Tobias Treppmann',
    jobTitle: 'Head of Product Design',
    email,
    url: 'https://treppmann.de/',
    address: { '@type': 'PostalAddress', addressLocality: 'Berlin', addressCountry: 'DE' },
  },
};
---

<Layout
  lang="de-DE"
  title="Tobias Treppmann – Bewerbung als Leitung UX + Produktivität beim rbb"
  description="Bewerbung von Tobias Treppmann als Leitung UX + Produktivität beim rbb."
  canonical={canonical}
  alternateDe={canonical}
  alternateEn="https://treppmann.de/en/"
  alternateDefault={canonical}
  noindex={true}
  image="https://treppmann.de/images/tobias-treppmann.jpg"
  structuredData={structuredData}
>
  <a class="skip-link" href="#main">Zum Inhalt</a>
  <header class="rb-top">
    <a href="/">Tobias Treppmann</a>
    <a href={cvHref} download>Lebenslauf (PDF)</a>
  </header>

  <main id="main" class="rb-page">
    <section class="rb-intro rb-shell">
      <div class="rb-intro-text">
        <p class="rb-meta">Bewerbung · Leitung UX + Produktivität</p>
        <h1>Tobias Treppmann</h1>
        <p>Ich bin Head of Product Design bei Bibel TV, einem Fernsehsender, der neben dem linearen Programm zunehmend auf Streaming setzt. Ich arbeite an den Apps für iOS, Android, Web und Connected TV mit Live-TV und Streaming, am Zuschauerservice und an der Aufbereitung der Predigtvideos.</p>
        <p>Bei Bibel TV habe ich KI-Werkzeuge gebaut und sie selbst im Team eingeführt. Einige davon beschreibe ich weiter unten.</p>
        <p>Davor habe ich Teams geführt. Bei Ninox saß ich im Senior Leadership Team und führte fünf Mitarbeitende, als Interim Head of Product neun. Bei Datameer habe ich fünf Jahre lang von Berlin aus ein UX-Team geleitet. Ein Teil des Teams saß in New York.</p>
      </div>
      <img class="rb-portrait" src="/images/tobias-treppmann.jpg" alt="Tobias Treppmann" width="600" height="750" />
    </section>

    <section class="rb-section rb-shell" id="arbeiten" aria-labelledby="arbeiten-h">
      <h2 id="arbeiten-h">Aus meiner Arbeit bei Bibel TV</h2>
      <div class="rb-work">
        {work.map((item) => (
          <article>
            <p class="rb-meta">{item.tag}</p>
            <h3>{item.title}</h3>
            {item.body.map((p) => <p>{p}</p>)}
            <a class="rb-link" href={item.href}>Fallstudie auf treppmann.design (Englisch)</a>
          </article>
        ))}
      </div>
    </section>

    <section class="rb-section rb-shell" id="erfahrung" aria-labelledby="erfahrung-h">
      <h2 id="erfahrung-h">Erfahrung</h2>
      <ol class="rb-cv">
        {experience.map((e) => (
          <li>
            <span class="rb-years">{e.years}</span>
            <div>
              <h3>{e.role}</h3>
              <p class="rb-org">{e.org}</p>
              {e.note && <p>{e.note}</p>}
            </div>
          </li>
        ))}
        <li>
          <span class="rb-years">2016 – 2026</span>
          <div>
            <h3>Senior Mentor (Nebentätigkeit)</h3>
            <p class="rb-org">CareerFoundry</p>
            <p>Zehn Jahre Einzel-Mentoring für Menschen, die ins UX-Design wechseln.</p>
          </div>
        </li>
        <li>
          <span class="rb-years">2026</span>
          <div>
            <h3>M.A. Leadership</h3>
            <p class="rb-org">Kairos University, South Dakota, USA</p>
          </div>
        </li>
      </ol>
    </section>

    <section class="rb-section rb-shell" id="kontakt" aria-labelledby="kontakt-h">
      <h2 id="kontakt-h">Kontakt</h2>
      <p>Sie erreichen mich per E-Mail unter <a class="rb-link" href={mailto}>{email}</a>. Den vollständigen Lebenslauf können Sie hier als PDF herunterladen.</p>
      <p class="rb-actions"><a class="rb-button" href={cvHref} download>Lebenslauf herunterladen (PDF)</a></p>
    </section>
  </main>

  <footer>
    <span>Tobias Treppmann · Berlin</span>
    <span><a href="/impressum/">Impressum</a> · <a href="/datenschutz/">Datenschutz</a></span>
  </footer>

  <style>
    .rb-shell { width: min(1040px, calc(100vw - 32px)); margin: 0 auto; }
    .rb-top { width: min(1040px, calc(100vw - 32px)); margin: 0 auto; padding: 1.4rem 0; display: flex; justify-content: space-between; gap: 1rem; font-size: .9rem; border-bottom: 1px solid var(--line); }
    .rb-top a:last-child { text-decoration: underline; text-underline-offset: 3px; }
    .rb-page { color: var(--ink); }
    .rb-page p { max-width: 64ch; }
    .rb-page h1, .rb-page h2, .rb-page h3 { letter-spacing: -0.02em; line-height: 1.15; font-weight: 600; }
    .rb-meta { font-size: .8rem; color: var(--muted); }
    .rb-intro { display: grid; grid-template-columns: minmax(0, 1fr) 260px; gap: 3.5rem; align-items: start; padding: 4rem 0 3.5rem; }
    .rb-intro h1 { font-size: 2.6rem; margin: .6rem 0 1.6rem; }
    .rb-intro-text > p:not(.rb-meta) { margin-top: 1rem; font-size: 1.05rem; }
    .rb-portrait { width: 260px; height: auto; margin-top: 2.2rem; }
    .rb-actions { display: flex; flex-wrap: wrap; align-items: center; gap: 1.2rem; margin-top: 1.8rem !important; }
    .rb-actions a:not(.rb-button), .rb-link { text-decoration: underline; text-underline-offset: 3px; }
    .rb-button { display: inline-flex; align-items: center; min-height: 46px; padding: 0 1.1rem; border: 1px solid var(--ink); font-size: .9rem; font-weight: 600; }
    .rb-button:hover { background: var(--ink); color: var(--white); }
    .rb-section { padding: 3rem 0; border-top: 1px solid var(--line); }
    .rb-section h2 { font-size: 1.6rem; margin-bottom: 1.6rem; }
    .rb-work { display: grid; gap: 2.4rem; }
    .rb-work article { display: grid; gap: .8rem; }
    .rb-work h3 { font-size: 1.3rem; }
    .rb-work p:not(.rb-meta) { font-size: 1rem; }
    .rb-link { font-size: .9rem; }
    .rb-cv { list-style: none; margin: 0; padding: 0; display: grid; gap: 1.5rem; }
    .rb-cv li { display: grid; grid-template-columns: 9rem minmax(0, 1fr); gap: 1.5rem; }
    .rb-years { font-size: .9rem; color: var(--muted); padding-top: .1rem; }
    .rb-cv h3 { font-size: 1.05rem; }
    .rb-org { color: var(--muted); font-size: .95rem; margin-top: .2rem !important; }
    .rb-cv p:not(.rb-org) { font-size: .95rem; margin-top: .4rem; }
    #kontakt p { font-size: 1.05rem; }
    .rb-page { padding-bottom: 3rem; }
    footer { font-family: var(--sans); text-transform: none; letter-spacing: 0; font-size: .8rem; }

    @media (max-width: 720px) {
      .rb-intro { grid-template-columns: 1fr; gap: 1.5rem; padding-top: 2.5rem; }
      .rb-intro h1 { font-size: 2.1rem; }
      .rb-portrait { width: 200px; margin-top: 0; grid-row: 1; }
      .rb-cv li { grid-template-columns: 1fr; gap: .3rem; }
    }
  </style>
</Layout>
