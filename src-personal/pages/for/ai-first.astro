---
import Layout from '../../../src/layouts/Layout.astro';

const canonical = 'https://treppmann.de/for/ai-first/';
const email = 'tobias@treppmann.de';
const mailto = `mailto:${email}?subject=${encodeURIComponent('Austausch zu AI FIRST')}`;

const proof = [
  {
    number: '01',
    eyebrow: 'Workflow → eingeführtes System',
    title: 'Copilot im Zuschauerservice',
    body: 'Aus wiederkehrenden Servicefragen entstand ein produktiv eingesetzter Microsoft-Copilot-Skill. Die Einführung verband Führungssponsoring, Demonstrationen, freiwillige Tests und individuelles Coaching.',
    result: 'Adoption ohne Nutzungszwang',
    note: 'Skeptische Teammitglieder kamen später aus eigenem Antrieb zurück.',
    href: '/beispiele/ki-assistent-zuschauerservice/',
  },
  {
    number: '02',
    eyebrow: 'Inhalt → aktiver Workflow',
    title: 'KI-Pipeline für Medieninhalte',
    body: 'Für ein konversationelles Produkt definierte und betreibe ich einen Workflow für Transkription, Inhaltsanalyse, Retrieval und virtuelle Clip-Erzeugung – verbunden mit Produktkonzept und bestehenden APIs.',
    result: 'Ein durchgängiger Ablauf',
    note: 'Statt einer Sammlung isolierter Demos und manueller Übergaben.',
  },
  {
    number: '03',
    eyebrow: 'Absicht → editierbares Produkt',
    title: 'AI-Onboarding für Ninox',
    body: 'Ich führte Produkt, UX und Prototyping für ein Onboarding, das natürliche Sprache in ein erstes editierbares Datenbankmodell übersetzt. Die Richtung wurde zur Grundlage der öffentlichen Ninox-AI-Beta.',
    result: 'Eine Produktentscheidung wurde testbar',
    note: 'Für ein komplexes No-Code-Produkt und Menschen ohne Entwicklungskenntnisse.',
    href: '/beispiele/ki-onboarding-ninox/',
  },
];

const contribution = [
  ['Kundenarbeit produktisieren', 'Wiederkehrende Probleme, Methoden und Lernschleifen in verständliche Diagnostik, Tools und wiederverwendbare Produktbausteine übersetzen.'],
  ['Vom Value Case zum Vertical Slice', 'Nicht beim Use-Case-Canvas stehen bleiben: den echten Workflow mit seinen Nutzern verstehen, eine funktionierende Intervention bauen und Erfolg beobachtbar machen.'],
  ['Enablement als Produkterlebnis', 'Programme, Hub und Arbeitsmaterial so gestalten, dass Menschen nicht nur lernen, sondern in ihrem Kontext selbst weiterbauen und gute Entscheidungen treffen können.'],
];

const structuredData = {
  '@context': 'https://schema.org',
  '@type': 'ProfilePage',
  name: 'Tobias Treppmann – möglicher Beitrag zu AI FIRST',
  url: canonical,
  mainEntity: {
    '@type': 'Person',
    name: 'Tobias Treppmann',
    jobTitle: 'AI Product & Transformation Leader',
    email,
    url: 'https://treppmann.de/',
    address: { '@type': 'PostalAddress', addressLocality: 'Berlin', addressCountry: 'DE' },
  },
};
---

<Layout
  lang="de-DE"
  title="Tobias Treppmann × AI FIRST – Produkt, Workflows und Adoption"
  description="Eine Gesprächshypothese: Wie Tobias Treppmann Produktführung, KI-Workflows, praktische Umsetzung und Adoption für AI FIRST verbinden könnte."
  canonical={canonical}
  alternateDe={canonical}
  alternateEn="https://treppmann.de/en/"
  alternateDefault={canonical}
  noindex={true}
  image="https://treppmann.de/images/tobias-treppmann.jpg"
  structuredData={structuredData}
>
  <a class="skip-link" href="#main">Zum Inhalt</a>

  <header class="af-topbar">
    <a class="af-brand" href="/" aria-label="Tobias Treppmann – Startseite">
      <span>Tobias Treppmann</span><b>×</b><span>AI FIRST</span>
    </a>
    <nav aria-label="Seitennavigation">
      <a href="#belege">Belege</a>
      <a href="#beitrag">Beitrag</a>
      <a href="#austausch">Austausch</a>
    </nav>
    <a class="af-contact" href={mailto}>Kontakt</a>
  </header>

  <main id="main" class="af-page">
    <section class="af-hero">
      <div class="af-shell af-hero-grid">
        <div class="af-hero-copy">
          <p class="af-kicker">Product · AI Workflows · Adoption</p>
          <h1><span>Die Arbeit verstehen.</span><span>Das System bauen.</span><em>Die Nutzung möglich machen.</em></h1>
          <p class="af-lead">Ich verbinde Produkt- und Designführung mit praktischer agentischer Umsetzung. Mein wiederkehrendes Muster: aus komplexer, domänenspezifischer Arbeit ein nutzbares System und eine Arbeitsweise machen, die Menschen übernehmen können.</p>
          <div class="af-actions">
            <a class="af-button af-button-primary" href="#belege">Belege ansehen <span aria-hidden="true">↓</span></a>
            <a class="af-button af-button-ghost" href={mailto}>Gespräch beginnen <span aria-hidden="true">↗</span></a>
          </div>
        </div>

        <aside class="af-hypothesis" aria-label="Gesprächshypothese">
          <span>Gesprächshypothese</span>
          <p>AI FIRST verbindet Enablement, Community und wiederverwendbare Systeme. Mein möglicher Beitrag liegt dort, wo aus wiederkehrenden Kundenproblemen skalierbare Tools, Produktbausteine und Umsetzungspfade werden.</p>
          <small>Keine Ferndiagnose. Eine Hypothese, die ich gern im Gespräch prüfe.</small>
        </aside>
      </div>
      <div class="af-ticker" aria-hidden="true">
        <span>OUTCOME</span><i>→</i><span>WORKFLOW</span><i>→</i><span>PRODUCT</span><i>→</i><span>WORKING SYSTEM</span><i>→</i><span>ADOPTION</span>
      </div>
    </section>

    <section class="af-intro">
      <div class="af-shell af-intro-grid">
        <p class="af-label">Warum diese Schnittstelle</p>
        <div>
          <h2>Player-Coach ist für mich kein Kompromiss zwischen Führung und Umsetzung.</h2>
          <p>Die wichtigen Entscheidungen entstehen näher an der Arbeit: wenn der echte Workflow sichtbar wird, eine Idee gegen reale Daten und Grenzen läuft und die späteren Nutzer mitgestalten. Ich kann auf dieser Ebene bauen – und gleichzeitig den Produkt-, Organisations- und Adoptionskontext zusammenhalten.</p>
        </div>
      </div>
    </section>

    <section class="af-proof" id="belege">
      <div class="af-shell af-section-heading">
        <p class="af-label">Ausgewählte Belege</p>
        <h2>Drei Stationen desselben Musters.</h2>
      </div>
      <div class="af-shell af-proof-grid">
        {proof.map((item) => (
          <article>
            <div class="af-proof-meta"><b>{item.number}</b><span>{item.eyebrow}</span></div>
            <h3>{item.title}</h3>
            <p>{item.body}</p>
            <div class="af-result"><strong>{item.result}</strong><span>{item.note}</span></div>
            {item.href && <a href={item.href}>Fallbeispiel ansehen <span aria-hidden="true">→</span></a>}
          </article>
        ))}
      </div>
    </section>

    <section class="af-contribution" id="beitrag">
      <div class="af-shell af-section-heading af-section-heading-light">
        <p class="af-label">Möglicher Beitrag</p>
        <h2>Wo die Kombination für AI FIRST nützlich werden könnte.</h2>
      </div>
      <ol class="af-shell af-contribution-list">
        {contribution.map(([title, body], index) => (
          <li>
            <span>{String(index + 1).padStart(2, '0')}</span>
            <h3>{title}</h3>
            <p>{body}</p>
          </li>
        ))}
      </ol>
    </section>

    <section class="af-profile">
      <div class="af-shell af-profile-grid">
        <div class="af-portrait">
          <img src="/images/tobias-treppmann-halftone.webp" alt="Tobias Treppmann" width="800" height="830" />
        </div>
        <div class="af-profile-copy">
          <p class="af-label">Tobias Treppmann</p>
          <h2>Seniorität ohne Abstand zur Arbeit.</h2>
          <p>Meine Laufbahn verbindet Produktführung, User Research, Service- und Prozessgestaltung, Facilitation und aktuelle agentische Umsetzung. Ich habe in Enterprise-Software, vertikalem SaaS, No-Code und Medienprodukten gearbeitet – vom Executive Alignment bis zum produktiven Workflow.</p>
          <p>Ich suche nicht die Rolle, in der ich KI-Arbeit verteile. Mich interessiert die Verantwortung, in der ich die Richtung mitbestimme, selbst etwas zum Laufen bringe und daraus eine Fähigkeit für andere mache.</p>
          <div class="af-links">
            <a href="/">AI-Leadership-Profil <span aria-hidden="true">→</span></a>
            <a href="https://treppmann.design">Product- und Designarbeit <span aria-hidden="true">↗</span></a>
          </div>
        </div>
      </div>
    </section>

    <section class="af-contact-section" id="austausch">
      <div class="af-shell af-contact-grid">
        <p class="af-label">Nächster Schritt</p>
        <div>
          <h2>Die Hypothese in 30 Minuten prüfen.</h2>
          <p>Wo entstehen bei AI FIRST gerade die wichtigsten Übergänge zwischen Enablement, Kundenworkflow, Produkt und Umsetzung? Das würde ich gern verstehen – und gemeinsam prüfen, ob meine Kombination für die nächste Phase nützlich ist.</p>
          <a class="af-button af-button-primary" href={mailto}>{email} <span aria-hidden="true">↗</span></a>
        </div>
      </div>
    </section>
  </main>

  <footer class="af-footer">
    <span>Tobias Treppmann · Berlin</span>
    <div><a href="/">treppmann.de</a><a href="/impressum/">Impressum</a><a href="/datenschutz/">Datenschutz</a></div>
  </footer>

  <style>
    :global(body) { background: #f4f1e8; }
    .af-page { --af-ink: #101310; --af-paper: #f4f1e8; --af-green: #b9ff2c; --af-cyan: #85f4dc; --af-line: rgba(16,19,16,.18); max-width: 100vw; overflow-x: clip; color: var(--af-ink); }
    .af-shell { width: min(100% - 64px, 1420px); margin-inline: auto; }
    .af-topbar { position: fixed; z-index: 20; inset: 0 0 auto; height: 68px; padding: 0 32px; display: grid; grid-template-columns: 1fr auto 1fr; align-items: center; color: #f4f1e8; background: rgba(16,19,16,.9); border-bottom: 1px solid rgba(244,241,232,.18); backdrop-filter: blur(12px); }
    .af-brand { display: flex; align-items: center; gap: .65rem; font-size: .78rem; font-weight: 650; }
    .af-brand b { color: #b9ff2c; }
    .af-topbar nav { display: flex; gap: 1.6rem; }
    .af-topbar nav a, .af-contact { font-size: .66rem; font-weight: 650; text-transform: uppercase; letter-spacing: .06em; }
    .af-contact { justify-self: end; padding-bottom: .18rem; border-bottom: 1px solid #b9ff2c; }
    .af-hero { min-height: 930px; padding: 180px 0 0; color: #f4f1e8; background: #101310; overflow: hidden; }
    .af-hero-grid { display: grid; grid-template-columns: minmax(0, 1.45fr) minmax(320px, .55fr); gap: clamp(3rem, 8vw, 9rem); align-items: end; }
    .af-kicker, .af-label { margin: 0; font-family: var(--mono); font-size: .66rem; text-transform: uppercase; letter-spacing: .08em; }
    .af-hero h1 { margin: 1.6rem 0 0; max-width: 1040px; font-size: clamp(4.4rem, 7.1vw, 8.6rem); line-height: .91; letter-spacing: -.06em; font-weight: 520; }
    .af-hero h1 span, .af-hero h1 em { display: block; }
    .af-hero h1 em { color: #b9ff2c; font-family: var(--serif); font-weight: 400; font-style: normal; }
    .af-lead { max-width: 870px; margin: 3rem 0 0; color: rgba(244,241,232,.72); font-size: clamp(1.2rem, 1.65vw, 1.65rem); line-height: 1.42; }
    .af-actions { display: flex; flex-wrap: wrap; gap: .8rem; margin-top: 2.5rem; }
    .af-button { display: inline-flex; align-items: center; justify-content: space-between; gap: 2rem; min-width: 210px; padding: .95rem 1.15rem; border: 1px solid currentColor; font-size: .72rem; font-weight: 700; }
    .af-button-primary { color: #101310; background: #b9ff2c; border-color: #b9ff2c; }
    .af-button-ghost { color: #f4f1e8; }
    .af-hypothesis { position: relative; padding: 2rem; color: #101310; background: #85f4dc; transform: rotate(1.4deg); box-shadow: 14px 14px 0 #b9ff2c; }
    .af-hypothesis > span { font-family: var(--mono); font-size: .63rem; text-transform: uppercase; letter-spacing: .08em; }
    .af-hypothesis p { margin: 4rem 0 2.5rem; font-size: clamp(1.35rem, 1.9vw, 2rem); line-height: 1.15; letter-spacing: -.025em; }
    .af-hypothesis small { display: block; padding-top: 1rem; border-top: 1px solid rgba(16,19,16,.35); font-size: .69rem; line-height: 1.45; }
    .af-ticker { margin-top: 7rem; min-width: max-content; padding: 1.2rem 0; display: flex; justify-content: center; gap: 1.5rem; color: #101310; background: #b9ff2c; font-family: var(--mono); font-size: .7rem; letter-spacing: .08em; }
    .af-ticker i { font-style: normal; }
    .af-intro, .af-proof, .af-profile, .af-contact-section { padding: 8rem 0; background: #f4f1e8; }
    .af-intro-grid { display: grid; grid-template-columns: minmax(180px, .3fr) minmax(0, 1fr); gap: 4rem; }
    .af-intro h2, .af-section-heading h2, .af-profile h2, .af-contact-section h2 { margin: 0; max-width: 1080px; font-size: clamp(3.1rem, 5.2vw, 6.3rem); line-height: .97; letter-spacing: -.05em; font-weight: 520; }
    .af-intro div > p { max-width: 810px; margin: 2.2rem 0 0; color: rgba(16,19,16,.67); font-size: 1.15rem; }
    .af-proof { padding-top: 2rem; }
    .af-section-heading { display: grid; grid-template-columns: minmax(180px, .3fr) minmax(0, 1fr); gap: 4rem; align-items: start; }
    .af-proof-grid { display: grid; grid-template-columns: repeat(3, 1fr); margin-top: 5rem; border-top: 1px solid var(--af-line); }
    .af-proof-grid article { min-height: 610px; padding: 1.5rem 2rem 2rem 0; border-right: 1px solid var(--af-line); display: flex; flex-direction: column; }
    .af-proof-grid article:not(:first-child) { padding-left: 2rem; }
    .af-proof-grid article:last-child { border-right: 0; }
    .af-proof-meta { display: flex; justify-content: space-between; gap: 1rem; font-family: var(--mono); font-size: .62rem; text-transform: uppercase; letter-spacing: .05em; }
    .af-proof-meta span { max-width: 210px; text-align: right; }
    .af-proof-grid h3 { margin: 5rem 0 1.2rem; font-size: clamp(2rem, 2.8vw, 3.25rem); line-height: 1; letter-spacing: -.04em; }
    .af-proof-grid article > p { margin: 0; color: rgba(16,19,16,.64); font-size: .9rem; }
    .af-result { margin-top: auto; padding-top: 3rem; display: grid; gap: .45rem; }
    .af-result strong { font-size: 1.25rem; }
    .af-result span { max-width: 320px; color: rgba(16,19,16,.62); font-size: .7rem; }
    .af-proof-grid a { align-self: flex-start; margin-top: 1.6rem; padding-bottom: .2rem; border-bottom: 1px solid; font-size: .72rem; font-weight: 700; }
    .af-contribution { padding: 8rem 0; color: #f4f1e8; background: #101310; }
    .af-section-heading-light .af-label { color: #b9ff2c; }
    .af-contribution-list { list-style: none; padding-left: 0; margin-top: 5rem; border-top: 1px solid rgba(244,241,232,.2); }
    .af-contribution-list li { min-height: 220px; padding: 2rem 0; display: grid; grid-template-columns: 100px minmax(280px, .65fr) minmax(0, 1fr); gap: 2rem; align-items: start; border-bottom: 1px solid rgba(244,241,232,.2); }
    .af-contribution-list span { color: #b9ff2c; font-family: var(--mono); font-size: .68rem; }
    .af-contribution-list h3 { margin: 0; font-size: clamp(1.8rem, 2.6vw, 3rem); line-height: 1; letter-spacing: -.035em; }
    .af-contribution-list p { margin: 0; max-width: 650px; color: rgba(244,241,232,.65); font-size: 1rem; }
    .af-profile-grid { display: grid; grid-template-columns: minmax(300px, .8fr) minmax(0, 1.2fr); gap: clamp(3rem, 8vw, 9rem); align-items: center; }
    .af-portrait { position: relative; min-height: 640px; overflow: hidden; background: #85f4dc; }
    .af-portrait::after { content: 'PLAYER / COACH'; position: absolute; inset: auto 1rem 1rem; padding: .75rem; color: #101310; background: #b9ff2c; font-family: var(--mono); font-size: .68rem; letter-spacing: .08em; }
    .af-portrait img { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; object-position: 50% 30%; filter: contrast(1.05); }
    .af-profile-copy > p:not(.af-label) { max-width: 800px; color: rgba(16,19,16,.65); font-size: 1.08rem; }
    .af-profile h2 { margin: 1.5rem 0 2.5rem; font-size: clamp(3rem, 4.8vw, 5.6rem); }
    .af-links { margin-top: 3rem; display: grid; border-top: 1px solid var(--af-line); }
    .af-links a { padding: 1rem 0; display: flex; justify-content: space-between; border-bottom: 1px solid var(--af-line); font-size: .78rem; font-weight: 700; }
    .af-contact-section { color: #f4f1e8; background: #101310; }
    .af-contact-grid { display: grid; grid-template-columns: minmax(180px, .3fr) minmax(0, 1fr); gap: 4rem; }
    .af-contact-section h2 { max-width: 1000px; }
    .af-contact-section p:not(.af-label) { max-width: 820px; margin: 2rem 0; color: rgba(244,241,232,.68); font-size: 1.1rem; }
    .af-footer { padding: 1.5rem 32px; display: flex; justify-content: space-between; gap: 2rem; color: rgba(244,241,232,.65); background: #101310; border-top: 1px solid rgba(244,241,232,.18); font-size: .65rem; }
    .af-footer div { display: flex; gap: 1.2rem; }
    @media (max-width: 900px) {
      .af-shell { width: min(100% - 32px, 1420px); }
      .af-topbar { padding: 0 16px; grid-template-columns: 1fr auto; }
      .af-topbar nav { display: none; }
      .af-hero { min-height: auto; padding-top: 130px; }
      .af-hero-grid, .af-intro-grid, .af-section-heading, .af-profile-grid, .af-contact-grid { grid-template-columns: 1fr; gap: 2.5rem; }
      .af-hero h1 { max-width: 100%; font-size: clamp(3.1rem, 13.5vw, 5.2rem); letter-spacing: -.055em; overflow-wrap: normal; }
      .af-hypothesis { margin-top: 1rem; transform: rotate(.5deg); }
      .af-ticker { justify-content: flex-start; padding-left: 1rem; }
      .af-intro, .af-proof, .af-profile, .af-contact-section, .af-contribution { padding: 5rem 0; }
      .af-proof-grid { grid-template-columns: 1fr; }
      .af-proof-grid article, .af-proof-grid article:not(:first-child) { min-height: 500px; padding: 1.5rem 0 2rem; border-right: 0; border-bottom: 1px solid var(--af-line); }
      .af-contribution-list li { grid-template-columns: 50px 1fr; min-height: 0; }
      .af-contribution-list p { grid-column: 2; }
      .af-portrait { min-height: 540px; }
      .af-footer { padding-inline: 16px; flex-direction: column; }
    }
  </style>
</Layout>
