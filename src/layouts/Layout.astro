---
import '../styles/global.css';

interface Props {
  lang: string;
  title: string;
  description: string;
  canonical: string;
  alternateDe?: string;
  alternateEn?: string;
  alternateDefault?: string;
  noindex?: boolean;
  image?: string;
  structuredData?: Record<string, unknown>;
}

const {
  lang,
  title,
  description,
  canonical,
  alternateDe = 'https://studio.treppmann.design/',
  alternateEn = 'https://studio.treppmann.design/en/',
  alternateDefault,
  noindex = false,
  image = 'https://studio.treppmann.design/images/tobias-treppmann.jpg',
  structuredData,
} = Astro.props;
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#11110f" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="canonical" href={canonical} />
    <link rel="alternate" hreflang="de" href={alternateDe} />
    <link rel="alternate" hreflang="en" href={alternateEn} />
    <link rel="alternate" hreflang="x-default" href={alternateDefault ?? alternateEn} />
    {noindex && <meta name="robots" content="noindex" />}
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={image} />
    <meta property="og:image:alt" content="Tobias Treppmann" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={image} />
    {structuredData && <script type="application/ld+json" set:html={JSON.stringify(structuredData)} />}
    <title>{title}</title>
  </head>
  <body>
    <slot />
    <script is:inline>
      (function () {
        if (!('IntersectionObserver' in window)) return;
        document.documentElement.classList.add('has-motion');
        var items = document.querySelectorAll('[data-reveal]');
        var observer = new IntersectionObserver(function (entries) {
          entries.forEach(function (entry) {
            if (!entry.isIntersecting) return;
            entry.target.classList.add('is-visible');
            observer.unobserve(entry.target);
          });
        }, { threshold: 0.08, rootMargin: '0px 0px -6% 0px' });
        items.forEach(function (item) { observer.observe(item); });
      })();
    </script>
  </body>
</html>
