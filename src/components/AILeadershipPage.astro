---
import Layout from '../layouts/Layout.astro';
import type { Locale } from '../data';
import { aiLeadershipContent } from '../aiLeadershipData';

interface Props { locale: Locale }
const { locale } = Astro.props;
const c = aiLeadershipContent[locale];
const canonical = `https://studio.treppmann.design${c.path}`;
const mailto = `mailto:${c.contact.cta}?subject=${encodeURIComponent(c.contact.subject)}`;
const portfolioUrl = 'https://treppmann.design';
---

<Layout
  lang={c.locale}
  title={c.metaTitle}
  description={c.metaDescription}
  canonical={canonical}
  alternateDe="https://studio.treppmann.design/ai-transformation/"
  alternateEn="https://studio.treppmann.design/en/ai-transformation/"
>
  <header class="topbar leadership-topbar">
    <a class="brand" href={c.homePath} aria-label="Treppmann Studio home">
      <span>Tobias</span><span class="brand-mark">/</span><span>AI Transformation</span>
    </a>
    <nav aria-label="Primary navigation">
      <a href="#needs">{c.nav.needs}</a>
      <a href="#services">{c.nav.services}</a>
      <a href="#proof">{c.nav.proof}</a>
      <a href="#about">{c.nav.about}</a>
    </nav>
    <a class="language" href={c.switchPath} lang={locale === 'de' ? 'en' : 'de'}>{c.switchLabel}</a>
  </header>

  <main class="leadership-page">
    <section class="leadership-hero section-dark">
      <div class="leadership-grid" aria-hidden="true"><span></span><span></span><span></span></div>
      <div class="section-shell leadership-hero-shell">
        <div class="leadership-hero-copy">
          <p class="eyebrow light">{c.hero.kicker}</p>
          <h1>{c.hero.title}</h1>
          <p class="hero-intro">{c.hero.intro}</p>
          <p class="hero-audience">{c.hero.audience}</p>
          <div class="hero-actions leadership-actions">
            <a class="button button-primary" href={mailto}>{c.hero.primary}</a>
            <a class="button button-ghost" href="#services">{c.hero.secondary}</a>
          </div>
          <a class="cv-link" href={c.hero.cv} download>{c.hero.cvLabel}<span aria-hidden="true"> ↓</span></a>
        </div>
        <figure class="leadership-portrait">
          <img src="/images/tobias-treppmann.jpg" alt={c.hero.portraitAlt} width="600" height="750" />
          <figcaption>
            <strong>Tobias Treppmann</strong>
            <span>{c.hero.portraitMeta}</span>
          </figcaption>
        </figure>
      </div>
    </section>

    <section class="experience-strip section-paper" aria-labelledby="leadership-experience-title">
      <div class="section-shell experience-heading">
        <p class="eyebrow" id="leadership-experience-title">{c.experience.label}</p>
      </div>
      <ul class="section-shell experience-brands" aria-label={c.experience.label}>
        {c.experience.brands.map((brand) => <li>{brand}</li>)}
      </ul>
    </section>

    <section class="needs-section section-light" id="needs">
      <div class="section-shell leadership-heading" data-reveal>
        <p class="eyebrow">{c.needs.label}</p>
        <div><h2>{c.needs.title}</h2><p class="lead">{c.needs.body}</p></div>
      </div>
      <div class="section-shell needs-grid">
        {c.needs.items.map(([title, body], index) => (
          <article data-reveal><span>0{index + 1}</span><h3>{title}</h3><p>{body}</p></article>
        ))}
      </div>
    </section>

    <section class="services-section section-paper" id="services">
      <div class="section-shell leadership-heading" data-reveal>
        <p class="eyebrow">{c.services.label}</p>
        <div><h2>{c.services.title}</h2><p class="lead">{c.services.intro}</p></div>
      </div>
      <div class="section-shell services-list">
        {c.services.items.map((item) => (
          <article data-reveal>
            <span class="service-number">{item.number}</span>
            <div class="service-copy"><h3>{item.title}</h3><p>{item.body}</p></div>
            <ul>{item.outcomes.map((outcome) => <li>{outcome}</li>)}</ul>
          </article>
        ))}
      </div>
      <div class="section-shell section-cta" data-reveal>
        <a class="button button-ink" href={mailto}>{c.services.cta}<span aria-hidden="true"> ↗</span></a>
      </div>
    </section>

    <section class="proof-section section-light" id="proof">
      <div class="section-shell leadership-heading" data-reveal>
        <p class="eyebrow">{c.proof.label}</p>
        <div><h2>{c.proof.title}</h2><p class="role-note">{c.proof.note}</p></div>
      </div>
      <div class="section-shell compact-proof-grid">
        {c.proof.cases.map((item, index) => (
          <article class="compact-proof-card" data-reveal>
            <div class="proof-context"><span>0{index + 1}</span><p>{item.context}</p></div>
            <h3>{item.title}</h3>
            <p class="proof-body">{item.body}</p>
            <div class="proof-result"><strong>{item.fact}</strong><span>{item.factLabel}</span></div>
            <a href={item.href}>{item.link}<span aria-hidden="true"> ↗</span></a>
          </article>
        ))}
      </div>
    </section>

    <section class="method-section section-dark" id="method">
      <div class="section-shell method-lead" data-reveal>
        <p class="eyebrow light">{c.method.label}</p>
        <h2>{c.method.title}</h2>
        <p>{c.method.body}</p>
      </div>
      <div class="section-shell method-path">
        {c.method.steps.map(([number, title, body], index) => (
          <article data-reveal>
            <div><span>{number}</span><h3>{title}</h3></div>
            <p>{body}</p>
            {index < c.method.steps.length - 1 && <i aria-hidden="true">→</i>}
          </article>
        ))}
      </div>
    </section>

    <section class="about-section section-paper" id="about">
      <div class="section-shell leadership-heading" data-reveal>
        <p class="eyebrow">{c.about.label}</p>
        <div><h2>{c.about.title}</h2><p class="lead">{c.about.body}</p></div>
      </div>
      <div class="section-shell about-points">
        {c.about.points.map(([title, body]) => (
          <article data-reveal><h3>{title}</h3><p>{body}</p></article>
        ))}
      </div>
      <div class="section-shell about-link"><a class="text-link" href={portfolioUrl}>{c.about.portfolio}<span aria-hidden="true"> ↗</span></a></div>
    </section>

    <section class="engagements-section section-signal">
      <div class="section-shell leadership-heading" data-reveal>
        <p class="eyebrow">{c.engagements.label}</p>
        <div><h2>{c.engagements.title}</h2><p class="lead">{c.engagements.intro}</p></div>
      </div>
      <div class="section-shell engagement-grid">
        {c.engagements.items.map(([title, body, action, subject]) => (
          <article data-reveal>
            <h3>{title}</h3>
            <p>{body}</p>
            <a href={`mailto:${c.contact.cta}?subject=${encodeURIComponent(subject)}`}>{action}<span aria-hidden="true"> ↗</span></a>
          </article>
        ))}
      </div>
    </section>

    <section class="contact leadership-contact section-dark" id="contact">
      <div class="section-shell contact-inner" data-reveal>
        <p class="eyebrow light">{c.contact.label}</p>
        <h2>{c.contact.title}</h2>
        <p>{c.contact.body}</p>
        <a class="contact-link" href={mailto}>{c.contact.cta}<span aria-hidden="true">↗</span></a>
        <div class="contact-meta"><p class="location">{c.contact.location}</p><a href={c.contact.linkedinUrl}>{c.contact.linkedin}<span aria-hidden="true"> ↗</span></a></div>
      </div>
    </section>
  </main>

  <footer>
    <span>{c.footer}</span>
    <div class="footer-links"><a href={c.homePath}>Studio</a><a href={c.switchPath}>{c.switchLabel}</a></div>
  </footer>
</Layout>
