---
import Layout from '../layouts/Layout.astro';
import type { Locale } from '../data';
import { aiLeadershipContent } from '../aiLeadershipData';

interface Props { locale: Locale; site?: 'studio' | 'personal' }
const { locale, site = 'studio' } = Astro.props;
const c = aiLeadershipContent[locale];
const isPersonal = site === 'personal';
const report = 'report' in c ? c.report : undefined;
const reportHref = report ? (isPersonal ? new URL(report.href).pathname : report.href) : '';
const checkHref = report ? (isPersonal ? new URL(report.checkHref).pathname : report.checkHref) : '';
const personalDe = 'https://treppmann.de/';
const personalEn = 'https://treppmann.de/en/';
const canonical = isPersonal
  ? (locale === 'en' ? personalEn : personalDe)
  : `https://studio.treppmann.design${c.path}`;
const alternateDe = isPersonal ? personalDe : 'https://studio.treppmann.design/ai-transformation/';
const alternateEn = isPersonal ? personalEn : 'https://studio.treppmann.design/en/ai-transformation/';
const homePath = isPersonal ? (locale === 'en' ? '/en/' : '/') : c.homePath;
const switchPath = isPersonal ? (locale === 'en' ? '/' : '/en/') : c.switchPath;
const mail = (subject: string) => `mailto:${c.contact.email}?subject=${encodeURIComponent(subject)}`;
const mailto = mail(c.contact.subject);
const legalBase = isPersonal ? '' : 'https://treppmann.de';
const impressumUrl = `${legalBase}/impressum/`;
const privacyUrl = `${legalBase}/datenschutz/`;
const portfolioUrl = 'https://treppmann.design';
const studioUrl = locale === 'de' ? 'https://studio.treppmann.design/' : 'https://studio.treppmann.design/en/';
const structuredData = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: 'Tobias Treppmann',
  url: isPersonal ? personalDe : canonical,
  image: 'https://treppmann.de/images/tobias-treppmann.jpg',
  jobTitle: c.jobTitle,
  address: { '@type': 'PostalAddress', addressLocality: 'Berlin', addressCountry: 'DE' },
  email: c.contact.email,
  sameAs: [c.contact.linkedinUrl, portfolioUrl, studioUrl],
  knowsAbout: locale === 'de'
    ? ['KI-Transformation', 'KI-Einführung', 'Prozessgestaltung', 'Produktführung', 'KI-Agenten']
    : ['AI transformation', 'AI adoption', 'Workflow design', 'Product leadership', 'AI agents'],
};
---

<Layout
  lang={c.locale}
  title={c.metaTitle}
  description={c.metaDescription}
  canonical={canonical}
  alternateDe={alternateDe}
  alternateEn={alternateEn}
  alternateDefault={isPersonal ? personalDe : alternateEn}
  image="https://treppmann.de/images/tobias-treppmann.jpg"
  structuredData={structuredData}
>
  <a class="skip-link" href="#main">{c.skip}</a>
  <header class="topbar leadership-topbar">
    <a class="brand" href={homePath} aria-label={c.homeLabel}>
      <span>Tobias Treppmann</span><span class="brand-mark">/</span><span>{c.brandSuffix}</span>
    </a>
    <nav aria-label={locale === 'de' ? 'Hauptnavigation' : 'Primary navigation'}>
      <a href="#needs">{c.nav.needs}</a>
      <a href="#proof">{c.nav.proof}</a>
      <a href="#plan">{c.nav.plan}</a>
      <a href="#formats">{c.nav.formats}</a>
      <a href="#about">{c.nav.about}</a>
    </nav>
    <div class="topbar-actions">
      <a class="topbar-contact" href="#contact">{c.nav.contact}</a>
      <a class="language" href={switchPath} lang={locale === 'de' ? 'en' : 'de'}>{c.switchLabel}</a>
    </div>
  </header>

  <main class="leadership-page" id="main">
    <section class="leadership-hero section-dark">
      <div class="section-shell leadership-hero-shell">
        <div class="leadership-hero-copy">
          <p class="hero-role">{c.hero.kicker}</p>
          <h1>{c.hero.title}</h1>
          <p class="hero-intro">{c.hero.intro}</p>
          <p class="hero-audience">{c.hero.audience}</p>
          <div class="hero-actions leadership-actions">
            <a class="button button-primary" href={c.contact.bookUrl} target="_blank" rel="noopener">{c.hero.primary}</a>
            <a class="button button-ghost" href="#plan">{c.hero.secondary}</a>
          </div>
          <p class="hero-proof"><strong>{c.hero.proofLabel}:</strong> {c.hero.proof}</p>
        </div>
        <figure class="leadership-portrait">
          <img src="/images/tobias-treppmann.jpg" alt={c.hero.portraitAlt} width="600" height="750" />
          <figcaption>
            <strong>Tobias Treppmann</strong>
            <span>{c.hero.portraitMeta}</span>
          </figcaption>
        </figure>
      </div>
    </section>

    <section class="credentials-strip section-paper" aria-label={c.credentials.label}>
      <ul class="section-shell credentials-list">
        {c.credentials.items.map(([name, body]) => (
          <li><strong>{name}</strong><span>{body}</span></li>
        ))}
      </ul>
    </section>

    <section class="needs-section section-light" id="needs">
      <div class="section-shell leadership-heading">
        <p class="section-label">{c.needs.label}</p>
        <div><h2>{c.needs.title}</h2><p class="lead">{c.needs.body}</p></div>
      </div>
      <div class="section-shell needs-grid">
        {c.needs.items.map(([title, body]) => (
          <article><h3>{title}</h3><p>{body}</p></article>
        ))}
      </div>
      <div class="section-shell"><p class="needs-closing">{c.needs.closing}</p>{report && <p class="report-teaser">{report.needsText} <a href={reportHref}>„{report.title}“<span aria-hidden="true"> →</span></a></p>}{report && <p class="report-teaser">{report.checkText} <a href={checkHref}>{report.checkLink}<span aria-hidden="true"> →</span></a></p>}</div>
    </section>

    <section class="why-section section-dark" aria-labelledby="why-title">
      <div class="section-shell leadership-heading leadership-heading-dark">
        <p class="section-label">{c.why.label}</p>
        <div><h2 id="why-title">{c.why.title}</h2></div>
      </div>
      <div class="section-shell why-grid">
        {c.why.items.map(([figure, text, source, url]) => (
          <article>
            <strong>{figure}</strong>
            <p>{text}</p>
            <a href={url} target="_blank" rel="noopener">{source}<span aria-hidden="true"> ↗</span></a>
          </article>
        ))}
      </div>
      {report && <div class="section-shell"><p class="report-teaser report-teaser-dark">{report.whyText} <a href={reportHref}>Report „{report.title}“ lesen<span aria-hidden="true"> →</span></a></p></div>}
    </section>

    <section class="proof-section section-paper" id="proof">
      <div class="section-shell leadership-heading">
        <p class="section-label">{c.proof.label}</p>
        <div><h2>{c.proof.title}</h2></div>
      </div>
      <div class="section-shell compact-proof-grid">
        {c.proof.cases.map((item) => (
          <article class="compact-proof-card">
            <div class="proof-context"><p>{item.context}</p></div>
            <h3>{item.title}</h3>
            <p class="proof-body">{item.body}</p>
            <div class="proof-result"><strong>{item.fact}</strong><span>{item.factLabel}</span></div>
            {'href' in item && <a href={item.href}>{item.link}<span aria-hidden="true"> ↗</span></a>}
          </article>
        ))}
      </div>
    </section>

    <section class="method-section section-dark" id="plan">
      <div class="section-shell leadership-heading leadership-heading-dark">
        <p class="section-label">{c.plan.label}</p>
        <div><h2>{c.plan.title}</h2><p class="lead">{c.plan.body}</p></div>
      </div>
      <ol class="section-shell method-path">
        {c.plan.steps.map(([when, title, body]) => (
          <li>
            <span>{when}</span>
            <h3>{title}</h3>
            <p>{body}</p>
          </li>
        ))}
      </ol>
    </section>

    <section class="engagements-section section-light" id="formats">
      <div class="section-shell leadership-heading">
        <p class="section-label">{c.formats.label}</p>
        <div><h2>{c.formats.title}</h2><p class="lead">{c.formats.intro}</p></div>
      </div>
      <div class="section-shell engagement-grid">
        {c.formats.items.map((item) => (
          <article>
            <h3>{item.title}</h3>
            <p class="engagement-meta">{item.meta}</p>
            <p>{item.body}</p>
            <div class="engagement-links">
              <a href={mail(item.subject)}>{item.action}<span aria-hidden="true"> →</span></a>
              {'secondary' in item && <a href={item.secondaryHref} download>{item.secondary}<span aria-hidden="true"> ↓</span></a>}
            </div>
          </article>
        ))}
      </div>
      <div class="section-shell engagement-extra">
        <div><h3>{c.formats.extra.title}</h3><p class="engagement-meta">{c.formats.extra.meta}</p></div>
        <div><p>{c.formats.extra.body}</p><a href={mail(c.formats.extra.subject)}>{c.formats.extra.action}<span aria-hidden="true"> →</span></a></div>
      </div>
      <div class="section-shell requirements">
        <h3>{c.formats.requirements.title}</h3>
        <ul>{c.formats.requirements.items.map((item) => <li>{item}</li>)}</ul>
      </div>
      <div class="section-shell section-cta">
        <a class="button button-ink" href={c.contact.bookUrl} target="_blank" rel="noopener">{c.contact.book}<span aria-hidden="true"> ↗</span></a>
      </div>
    </section>

    <section class="about-section section-paper" id="about">
      <div class="section-shell leadership-heading">
        <p class="section-label">{c.about.label}</p>
        <div><h2>{c.about.title}</h2><p class="lead">{c.about.body}</p></div>
      </div>
      <div class="section-shell about-points">
        {c.about.points.map(([title, body]) => (
          <article><h3>{title}</h3><p>{body}</p></article>
        ))}
      </div>
      <div class="section-shell about-link"><a class="text-link" href={portfolioUrl}>{c.about.portfolio}<span aria-hidden="true"> ↗</span></a></div>
    </section>

    <section class="faq-section section-light" id="faq">
      <div class="section-shell leadership-heading">
        <p class="section-label">{c.faq.label}</p>
        <div>
          <h2>{c.faq.title}</h2>
          <div class="faq-list">
            {c.faq.items.map(([question, answer]) => (
              <details>
                <summary>{question}</summary>
                <p>{answer}</p>
              </details>
            ))}
          </div>
        </div>
      </div>
    </section>

    <section class="contact leadership-contact section-dark" id="contact">
      <div class="section-shell contact-inner">
        <h2>{c.contact.title}</h2>
        <p>{c.contact.body}</p>
        <div class="contact-actions">
          <a class="button button-primary" href={c.contact.bookUrl} target="_blank" rel="noopener">{c.contact.book}</a>
          <a class="contact-link" href={mailto}>{c.contact.email}<span aria-hidden="true">↗</span></a>
        </div>
        <div class="contact-meta"><p class="location">{c.contact.location}</p><a href={c.contact.linkedinUrl}>{c.contact.linkedin}<span aria-hidden="true"> ↗</span></a></div>
      </div>
    </section>
  </main>

  <footer class="leadership-footer">
    <span>{c.footer.name}</span>
    <div class="footer-links">
      <a href={impressumUrl}>{c.footer.impressum}</a>
      <a href={privacyUrl}>{c.footer.privacy}</a>
      {report && <a href={reportHref}>{report.footer}</a>}{report && <a href={checkHref}>{report.checkFooter}</a>}
      <a href={portfolioUrl}>{c.footer.portfolio}</a>
      <a href={switchPath}>{c.switchLabel}</a>
    </div>
  </footer>
</Layout>
