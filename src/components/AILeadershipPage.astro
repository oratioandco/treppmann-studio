---
import Layout from '../layouts/Layout.astro';
import type { Locale } from '../data';
import { aiLeadershipContent } from '../aiLeadershipData';

interface Props { locale: Locale; site?: 'studio' | 'personal' }
const { locale, site = 'studio' } = Astro.props;
const c = aiLeadershipContent[locale];
const isPersonal = site === 'personal';
const report = 'report' in c ? c.report : undefined;
const reportHref = report ? (isPersonal ? new URL(report.href).pathname : report.href) : '';
const checkHref = report ? (isPersonal ? new URL(report.checkHref).pathname : report.checkHref) : '';
const personalDe = 'https://treppmann.de/';
const personalEn = 'https://treppmann.de/en/';
const canonical = isPersonal
  ? (locale === 'en' ? personalEn : personalDe)
  : `https://studio.treppmann.design${c.path}`;
const alternateDe = isPersonal ? personalDe : 'https://studio.treppmann.design/ai-transformation/';
const alternateEn = isPersonal ? personalEn : 'https://studio.treppmann.design/en/ai-transformation/';
const homePath = isPersonal ? (locale === 'en' ? '/en/' : '/') : c.homePath;
const switchPath = isPersonal ? (locale === 'en' ? '/' : '/en/') : c.switchPath;
const mail = (subject: string) => `mailto:${c.contact.email}?subject=${encodeURIComponent(subject)}`;
const mailto = mail(c.contact.subject);
const legalBase = isPersonal ? '' : 'https://treppmann.de';
const impressumUrl = `${legalBase}/impressum/`;
const privacyUrl = `${legalBase}/datenschutz/`;
const portfolioUrl = 'https://treppmann.design';
const studioUrl = locale === 'de' ? 'https://studio.treppmann.design/' : 'https://studio.treppmann.design/en/';
const structuredData = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: 'Tobias Treppmann',
  url: isPersonal ? personalDe : canonical,
  image: 'https://treppmann.de/images/tobias-treppmann.jpg',
  jobTitle: c.jobTitle,
  address: { '@type': 'PostalAddress', addressLocality: 'Berlin', addressCountry: 'DE' },
  email: c.contact.email,
  sameAs: [c.contact.linkedinUrl, portfolioUrl, studioUrl],
  knowsAbout: locale === 'de'
    ? ['KI-Transformation', 'KI-Einführung', 'Prozessgestaltung', 'Produktführung', 'KI-Agenten']
    : ['AI transformation', 'AI adoption', 'Workflow design', 'Product leadership', 'AI agents'],
};
---

<Layout
  lang={c.locale}
  title={c.metaTitle}
  description={c.metaDescription}
  canonical={canonical}
  alternateDe={alternateDe}
  alternateEn={alternateEn}
  alternateDefault={isPersonal ? personalDe : alternateEn}
  image="https://treppmann.de/images/tobias-treppmann.jpg"
  structuredData={structuredData}
>
  <a class="skip-link" href="#main">{c.skip}</a>
  <header class="topbar leadership-topbar">
    <a class="brand" href={homePath} aria-label={c.homeLabel}>
      <span>Tobias Treppmann</span><span class="brand-mark">/</span><span>{c.brandSuffix}</span>
    </a>
    <nav aria-label={locale === 'de' ? 'Hauptnavigation' : 'Primary navigation'}>
      <a href="#needs">{c.nav.needs}</a>
      <a href="#proof">{c.nav.proof}</a>
      <a href="#plan">{c.nav.plan}</a>
      <a href="#formats">{c.nav.formats}</a>
      {report && <a href="#check">{report.nav}</a>}
      <a href="#about">{c.nav.about}</a>
    </nav>
    <div class="topbar-actions">
      <a class="topbar-contact" href="#contact">{c.nav.contact}</a>
      <a class="language" href={switchPath} lang={locale === 'de' ? 'en' : 'de'}>{c.switchLabel}</a>
    </div>
  </header>

  <main class="leadership-page" id="main">
    <section class="leadership-hero section-dark">
      <div class="section-shell leadership-hero-shell">
        <div class="leadership-hero-copy">
          <p class="hero-role">{c.hero.kicker}</p>
          <h1>{c.hero.title}</h1>
          <p class="hero-intro">{c.hero.intro}</p>
          <p class="hero-audience">{c.hero.audience}</p>
          <div class="hero-actions leadership-actions">
            <a class="button button-primary" href={c.contact.bookUrl} target="_blank" rel="noopener">{c.hero.primary}</a>
            <a class="button button-ghost" href="#plan">{c.hero.secondary}</a>
          </div>
          <p class="hero-proof"><strong>{c.hero.proofLabel}:</strong> {c.hero.proof}</p>
        </div>
        <figure class="hero-collage">
          <div class="collage-sun" aria-hidden="true"></div>
          <nav class="collage-steps" aria-label={c.hero.stepsLabel}>
            <p class="collage-steps-label"><span>{c.hero.stepsLabel}</span> <a href={c.hero.stepsHref}>{c.hero.stepsAction}<span aria-hidden="true"> →</span></a></p>
            <ol>
              {c.hero.stages.map((name, i) => (
                <li style={`--n:${i + 1}`}>
                  <a href={c.hero.stepsHref}><b>{i + 1}</b><span class="collage-step-name">{name}</span></a>
                </li>
              ))}
            </ol>
          </nav>
          <img class="collage-portrait" src="/images/tobias-treppmann-halftone.webp" alt={c.hero.portraitAlt} width="800" height="830" />
          <p class="collage-ticket" aria-hidden="true">
            <span>{c.hero.ticket[0]}</span>
            <strong>{c.hero.ticket[1]}</strong>
            <em>{c.hero.ticket[2]}</em>
          </p>
          <figcaption>
            <strong>Tobias Treppmann</strong>
            <span>{c.hero.portraitMeta}</span>
          </figcaption>
        </figure>
      </div>
    </section>

    <section class="credentials-strip section-paper" aria-label={c.credentials.label}>
      <ul class="section-shell credentials-list" data-reveal data-stagger>
        {c.credentials.items.map(([name, body], i) => (
          <li style={`--i:${i}`}><strong>{name}</strong><span>{body}</span></li>
        ))}
      </ul>
    </section>

    <section class="needs-section section-light" id="needs">
      <div class="section-shell leadership-heading" data-reveal>
        <p class="section-label">{c.needs.label}</p>
        <div><h2>{c.needs.title}</h2><p class="lead">{c.needs.body}</p></div>
      </div>
      <div class="section-shell needs-grid" data-reveal data-stagger>
        {c.needs.items.map(([title, body], i) => (
          <article style={`--i:${i}`}>
            <figure class={`collage-object collage-sequence shape-${['circle', 'square', 'arch'][i]}`} aria-hidden="true" data-frame="0" style="--frames:6">
              {[1, 2, 3, 4, 5, 6].map((n) => <img class={n === 1 ? 'is-on' : undefined} src={`/images/collage/${['keycard', 'notes', 'cord'][i]}-f${n}.webp`} alt="" decoding="async" />)}
              <figcaption><span class="tag-before">{c.needs.frameTags[0]}</span><span class="tag-after">{c.needs.frameTags[1]}</span></figcaption>
            </figure>
            <h3>{title}</h3><p>{body}</p>
          </article>
        ))}
      </div>
      <div class="section-shell"><p class="needs-closing">{c.needs.closing}</p></div>
    </section>

    <section class="why-section section-dark" aria-labelledby="why-title">
      <div class="section-shell leadership-heading leadership-heading-dark" data-reveal>
        <p class="section-label">{c.why.label}</p>
        <div><h2 id="why-title">{c.why.title}</h2></div>
      </div>
      <div class="section-shell why-grid" data-reveal data-stagger data-count-group>
        {c.why.items.map(([figure, text, source, url], i) => (
          <article style={`--i:${i}`}>
            <strong data-count={figure}>{figure}</strong>
            <p>{text}</p>
            {url.startsWith('https://treppmann.de/') ? <a href={isPersonal ? url.replace('https://treppmann.de', '') : url}>{source}<span aria-hidden="true"> →</span></a> : <a href={url} target="_blank" rel="noopener">{source}<span aria-hidden="true"> ↗︎</span></a>}
          </article>
        ))}
      </div>
    </section>

    {report && (
      <section class="tools-section section-light" id="check">
        <div class="section-shell leadership-heading" data-reveal>
          <p class="section-label">{report.toolsLabel}</p>
          <div><h2>{report.toolsTitle}</h2></div>
        </div>
        <div class="section-shell tools-grid" data-reveal data-stagger>
          <a class="tool-card tool-card-dark" href={checkHref} style="--i:0">
            <div class="tool-visual tool-ladder" aria-hidden="true">
              {[1, 2, 3, 4, 5].map((n) => <span style={`--n:${n}`}><b>{n}</b></span>)}
            </div>
            <p class="tool-meta">{report.checkMeta}</p>
            <h3>{report.checkTitle}</h3>
            <p>{report.checkBody}</p>
            <span class="tool-action">{report.checkAction}<span aria-hidden="true"> →</span></span>
          </a>
          <a class="tool-card" href={reportHref} style="--i:1">
            <div class="tool-visual tool-bars" aria-hidden="true">
              {[[0, 'Vollständig'], [3, 'Eher stark'], [28, 'Wenig'], [59, 'Gar nicht']].map(([v, l]) => <span style={`--v:${v}`}><i></i><em>{l}</em><b>{v}&#8239;%</b></span>)}
            </div>
            <p class="tool-meta">{report.reportMeta}</p>
            <h3>„{report.title}“</h3>
            <p>{report.reportBody}</p>
            <span class="tool-action">{report.reportAction}<span aria-hidden="true"> →</span></span>
          </a>
        </div>
      </section>
    )}

    <section class="proof-section section-paper" id="proof">
      <div class="section-shell leadership-heading" data-reveal>
        <p class="section-label">{c.proof.label}</p>
        <div><h2>{c.proof.title}</h2></div>
      </div>
      <div class="section-shell compact-proof-grid" data-reveal data-stagger>
        {c.proof.cases.map((item, i) => (
          <article class="compact-proof-card" style={`--i:${i}`}>
            <div class="proof-context"><p>{item.context}</p></div>
            <figure class={`collage-object shape-${['arch', 'circle', 'square'][i]}`} aria-hidden="true"><img src={`/images/collage/${['letters', 'hands', 'blocks'][i]}.webp`} alt="" loading="lazy" /></figure>
            <h3>{item.title}</h3>
            <p class="proof-body">{item.body}</p>
            <div class="proof-result"><strong>{item.fact}</strong><span>{item.factLabel}</span></div>
            {'href' in item && <a class="proof-link" href={isPersonal ? new URL(item.href).pathname : item.href}>{item.link}<span aria-hidden="true"> →</span></a>}
          </article>
        ))}
      </div>
    </section>

    <section class="method-section section-dark" id="plan">
      <div class="section-shell leadership-heading leadership-heading-dark" data-reveal>
        <p class="section-label">{c.plan.label}</p>
        <div><h2>{c.plan.title}</h2><p class="lead">{c.plan.body}</p></div>
      </div>
      <ol class="section-shell method-path" data-reveal data-stagger data-steps>
        {c.plan.steps.map(([when, title, body], i) => (
          <li style={`--i:${i}`}>
            <figure class={`collage-object method-object shape-${['circle', 'arch', 'square', 'circle', 'arch'][i]}`} aria-hidden="true">
              <img src={`/images/collage/plan-${['goal', 'process', 'choice', 'build', 'measure'][i]}.webp`} alt="" loading="lazy" />
            </figure>
            <span>{when}</span>
            <h3>{title}</h3>
            <p>{body}</p>
          </li>
        ))}
      </ol>
    </section>

    <section class="engagements-section section-light" id="formats">
      <div class="section-shell leadership-heading" data-reveal>
        <p class="section-label">{c.formats.label}</p>
        <div><h2>{c.formats.title}</h2><p class="lead">{c.formats.intro}</p></div>
      </div>
      <div class="section-shell engagement-grid" data-reveal data-stagger>
        {c.formats.items.map((item, i) => (
          <article style={`--i:${i}`}>
            <h3>{item.title}</h3>
            <p class="engagement-meta">{item.meta}</p>
            <p>{item.body}</p>
            <div class="engagement-links">
              <a href={mail(item.subject)}>{item.action}<span aria-hidden="true"> →</span></a>
              {'secondary' in item && <a href={item.secondaryHref} download>{item.secondary}<span aria-hidden="true"> ↓</span></a>}
            </div>
          </article>
        ))}
      </div>
      <div class="section-shell engagement-extra" data-reveal>
        <div><h3>{c.formats.extra.title}</h3><p class="engagement-meta">{c.formats.extra.meta}</p></div>
        <div><p>{c.formats.extra.body}</p><a href={mail(c.formats.extra.subject)}>{c.formats.extra.action}<span aria-hidden="true"> →</span></a></div>
      </div>
      <div class="section-shell requirements">
        <div>
          <h3>{c.formats.requirements.title}</h3>
          <figure class="collage-object collage-object-small shape-circle" aria-hidden="true"><img src="/images/collage/stamp.webp" alt="" loading="lazy" /></figure>
        </div>
        <ul>{c.formats.requirements.items.map((item) => <li>{item}</li>)}</ul>
      </div>
      <div class="section-shell section-cta">
        <a class="button button-ink" href={c.contact.bookUrl} target="_blank" rel="noopener">{c.contact.book}<span aria-hidden="true"> ↗︎</span></a>
      </div>
    </section>

    <section class="about-section section-paper" id="about">
      <div class="section-shell leadership-heading" data-reveal>
        <div class="about-side">
          <p class="section-label">{c.about.label}</p>
          <figure class="about-stage">
            <div class="about-stage-arch" aria-hidden="true"></div>
            <img src="/images/collage/tobias-stage.webp" alt={c.about.stageAlt} width="500" height="900" loading="lazy" />
            <p class="about-stage-slip" aria-hidden="true">{c.about.stageSlip}</p>
            <figcaption>{c.about.stageCaption}</figcaption>
          </figure>
        </div>
        <div><h2>{c.about.title}</h2><p class="lead">{c.about.body}</p>
          <figure class="about-keynote">
            <img src="/images/collage/tobias-iccm.webp" alt={c.about.keynoteAlt} width="900" height="600" loading="lazy" />
            <figcaption>{c.about.keynoteCaption} <em>{c.about.keynoteLabel}</em></figcaption>
          </figure>
        </div>
      </div>
      <div class="section-shell about-points" data-reveal data-stagger>
        {c.about.points.map(([title, body], i) => (
          <article style={`--i:${i}`}><h3>{title}</h3><p>{body}</p></article>
        ))}
      </div>
      <div class="section-shell about-link"><a class="text-link" href={portfolioUrl}>{c.about.portfolio}<span aria-hidden="true"> ↗︎</span></a></div>
    </section>

    <section class="faq-section section-light" id="faq">
      <div class="section-shell leadership-heading" data-reveal>
        <p class="section-label">{c.faq.label}</p>
        <div>
          <h2>{c.faq.title}</h2>
          <div class="faq-list">
            {c.faq.items.map(([question, answer]) => (
              <details>
                <summary>{question}</summary>
                <p>{answer}</p>
              </details>
            ))}
          </div>
        </div>
      </div>
    </section>

    <section class="contact leadership-contact section-dark" id="contact">
      <div class="section-shell contact-inner" data-reveal>
        <h2>{c.contact.title}</h2>
        <p>{c.contact.body}</p>
        <div class="contact-actions">
          <a class="button button-primary" href={c.contact.bookUrl} target="_blank" rel="noopener">{c.contact.book}</a>
          <a class="contact-link" href={mailto}>{c.contact.email}<span aria-hidden="true">↗︎</span></a>
        </div>
        <div class="contact-meta"><p class="location">{c.contact.location}</p><a href={c.contact.linkedinUrl}>{c.contact.linkedin}<span aria-hidden="true"> ↗︎</span></a></div>
      </div>
    </section>
  </main>

  <footer class="leadership-footer">
    <span>{c.footer.name}</span>
    <div class="footer-links">
      <a href={impressumUrl}>{c.footer.impressum}</a>
      <a href={privacyUrl}>{c.footer.privacy}</a>
      {report && <a href={reportHref}>{report.footer}</a>}{report && <a href={checkHref}>{report.checkFooter}</a>}
      <a href={portfolioUrl}>{c.footer.portfolio}</a>
      <a href={switchPath}>{c.switchLabel}</a>
    </div>
  </footer>

  <script is:inline>
    (function () {
      var reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
      if (reduce || !('IntersectionObserver' in window)) return;

      // Figures count to their value once visible; 0 % counts down from 100 to make the gap felt.
      var counters = document.querySelectorAll('[data-count]');
      var io = new IntersectionObserver(function (entries) {
        entries.forEach(function (entry) {
          if (!entry.isIntersecting) return;
          io.unobserve(entry.target);
          var el = entry.target;
          var m = /^(\d+)(.*)$/.exec(el.dataset.count);
          if (!m) return;
          var to = Number(m[1]);
          var from = to === 0 ? 100 : 0;
          var rest = m[2];
          var final = el.dataset.count;
          var live = document.createElement('span');
          live.setAttribute('aria-hidden', 'true');
          var sr = document.createElement('span');
          sr.className = 'sr-only';
          sr.textContent = final;
          el.textContent = '';
          el.append(live, sr);
          var meter = document.createElement('span');
          meter.className = 'why-meter';
          meter.setAttribute('aria-hidden', 'true');
          meter.innerHTML = '<span></span>';
          el.after(meter);
          var start = null;
          var delay = 250 + Number(getComputedStyle(el.closest('article')).getPropertyValue('--i') || 0) * 120;
          var duration = 1400;
          function frame(t) {
            if (start === null) start = t + delay;
            var p = Math.min(1, Math.max(0, (t - start) / duration));
            var e = 1 - Math.pow(1 - p, 3);
            var v = Math.round(from + (to - from) * e);
            live.textContent = v + rest;
            meter.firstChild.style.transform = 'scaleX(' + (v / 100) + ')';
            if (p < 1) requestAnimationFrame(frame);
          }
          live.textContent = from + rest;
          meter.firstChild.style.transform = 'scaleX(' + (from / 100) + ')';
          requestAnimationFrame(frame);
        });
      }, { threshold: 0.5 });
      counters.forEach(function (el) { if (/^\d/.test(el.dataset.count)) io.observe(el); });

      // The five steps fill one after another as the reader scrolls through them.
      var path = document.querySelector('[data-steps]');
      if (!path) return;
      var steps = Array.prototype.slice.call(path.children);
      var ticking = false;
      function update() {
        ticking = false;
        var vh = window.innerHeight;
        var oneRow = steps.every(function (li) { return li.offsetTop === steps[0].offsetTop; });
        if (oneRow) {
          var r = path.getBoundingClientRect();
          var p = Math.min(1, Math.max(0, (vh * 0.85 - r.top) / (vh * 0.55)));
          steps.forEach(function (li, i) {
            var f = Math.min(1, Math.max(0, p * steps.length - i));
            li.style.setProperty('--fill', f.toFixed(3));
            li.classList.toggle('is-on', f >= 1);
          });
        } else {
          steps.forEach(function (li) {
            var top = li.getBoundingClientRect().top;
            var f = Math.min(1, Math.max(0, (vh * 0.8 - top) / (vh * 0.25)));
            li.style.setProperty('--fill', f.toFixed(3));
            li.classList.toggle('is-on', f >= 1);
          });
        }
      }
      function onScroll() { if (!ticking) { ticking = true; requestAnimationFrame(update); } }
      window.addEventListener('scroll', onScroll, { passive: true });
      window.addEventListener('resize', onScroll);
      update();
    })();
  
  // Stop-motion: each blocker image steps from problem to solution as its card scrolls through
  if (!matchMedia('(prefers-reduced-motion: reduce)').matches) {
    const seqs = [...document.querySelectorAll('.collage-sequence')];
    const step = () => {
      const vh = innerHeight;
      seqs.forEach((el) => {
        const r = el.getBoundingClientRect();
        const imgs = el.querySelectorAll('img');
        const last = imgs.length - 1;
        const p = Math.min(1, Math.max(0, (vh * 0.92 - r.top) / (vh * 0.62)));
        const f = Math.min(last, Math.floor(p * imgs.length));
        if (el.dataset.frame !== String(f)) {
          imgs.forEach((img, n) => img.classList.toggle('is-on', n === f));
          el.dataset.frame = String(f);
          el.dataset.done = f === last ? 'true' : 'false';
          el.style.setProperty('--jit', `${(Math.random() * 4 - 2).toFixed(2)}deg`);
        }
      });
    };
    let raf = 0;
    addEventListener('scroll', () => { cancelAnimationFrame(raf); raf = requestAnimationFrame(step); }, { passive: true });
    step();
  }
</script>
</Layout>
